// ── Decision Log ──────────────────────────────────────────────────────────────

model Decision {
  id          String         @id @default(cuid())
  title       String
  description String?
  rationale   String?
  status      DecisionStatus @default(Open)
  decidedAt   DateTime?
  goalId      String?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  goal      Goal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdBy User  @relation(fields: [createdById], references: [id], onDelete: Cascade)
}

// ── Audit Trail ───────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // "Goal" | "Pitstop" | "User" | "System"
  entityId   String
  userId     String // actor (the user who performed the action)
  action     String // "created" | "updated" | "deleted" | "role_change" | "password_reset" | "password_change" | "portal_access" | ...
  field      String?
  oldValue   String?
  newValue   String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([action, createdAt])
}

// ── Risk Registry ─────────────────────────────────────────────────────────────

model Risk {
  id          String         @id @default(cuid())
  title       String
  description String?
  likelihood  RiskLikelihood @default(Medium)
  impact      RiskImpact     @default(Medium)
  mitigation  String?
  status      RiskStatus     @default(Open)
  goalId      String?
  pitstopId   String?
  createdById String
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // ── Grant risk register ───────────────────────────────────────────────────
  // An appraisal's risk list becomes a register only if it survives the
  // decision: recordDecision() copies the appraisal's RiskEntry rows here with
  // budgetId + sourceDecisionId set and a review date, so "what did we say the
  // risks were" has an answer after approval.
  budgetId        String?
  budget          Budget?        @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  sourceDecisionId String?
  sourceDecision   GrantDecision? @relation("RiskSourceDecision", fields: [sourceDecisionId], references: [id], onDelete: SetNull)
  reviewDueOn      DateTime?      @db.Date

  goal      Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  pitstop   Pitstop? @relation(fields: [pitstopId], references: [id], onDelete: SetNull)
  createdBy User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([budgetId, status])
  @@index([reviewDueOn])
}

// ── Broadcast Updates ─────────────────────────────────────────────────────────

model GoalBroadcast {
  id        String    @id @default(cuid())
  goalId    String
  authorId  String
  title     String
  body      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  goal   Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// ── Metrics / KPIs ────────────────────────────────────────────────────────────

model GoalMetric {
  id          String          @id @default(cuid())
  goalId      String
  name        String
  description String?
  target      Float
  current     Float           @default(0)
  unit        String?
  frequency   MetricFrequency @default(Monthly)
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  goal       Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  dataPoints MetricDataPoint[]
}

model MetricDataPoint {
  id        String   @id @default(cuid())
  metricId  String
  value     Float
  note      String?
  date      DateTime
  userId    String
  createdAt DateTime @default(now())

  metric GoalMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Layer 2: Facility / Settlement Indicators ────────────────────────────────
// Ongoing state of community facilities/services — enrollment %, attendance,
// downtime, saturation %. Distinct from Layer 1 (needs remaining, fixed
// baseline) and from goal-scoped GoalMetric. Sourced from MIS APIs, RP activity
// completions, or manual admin entry — all config-driven, no hardcoding.

enum FacilityIndicatorSource {
  MIS_API
  RP_ACTIVITY
  MANUAL_ADMIN
}

model FacilityIndicatorDef {
  id               String          @id @default(cuid())
  key              String          @unique // e.g. "creche_enrollment_pct"
  label            String
  description      String?
  domain           String // links to NeedsFormulaConfig.domain
  facilityLayerKey String? // links to FacilityLayerConfig.layerKey (optional narrowing)
  schemeId         String? // links to EntitlementScheme (optional)
  unit             String? // "%", "count", "litres", etc.
  frequency        MetricFrequency @default(Monthly)
  color            String          @default("#6366f1")

  // Target — nullable for trend-only indicators. JSON describes how to compute:
  // { type: "fixed", value: number }
  // { type: "settlement_field", field: string, multiplier: number }
  // { type: "facility_count", multiplier: number }
  // { type: "scheme_baseline", multiplier: number }
  targetFormula Json?

  // Capture source (mutually exclusive — drives which fields below matter)
  captureSource  FacilityIndicatorSource
  // MIS_API path
  misProviderId  String?
  misFetchConfig Json? // provider-specific, e.g. { endpoint, valuePath, settlementCodePath, filters }
  // RP_ACTIVITY path: see ActivityIndicatorBinding (separate table — many bindings possible)

  // Staleness lens — same UX as Layer 1
  staleYellowDays Int @default(45)
  staleRedDays    Int @default(90)

  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  misProvider      MISProviderConfig?          @relation(fields: [misProviderId], references: [id], onDelete: SetNull)
  scheme           EntitlementScheme?          @relation("IndicatorScheme", fields: [schemeId], references: [id], onDelete: SetNull)
  indicators       FacilityIndicator[]
  activityBindings ActivityIndicatorBinding[]
  checklistItems   IndicatorChecklistItemDef[]
}

model FacilityIndicator {
  id             String                   @id @default(cuid())
  defId          String
  settlementId   String
  // Per-facility grain: set when the value was captured against a specific
  // facility (a facility-linked goal's LayerFeature). NULL = settlement-level
  // aggregate (MIS sync, civic domains, goals with no linked facility).
  facilityId     String?
  currentValue   Float?
  targetValue    Float? // snapshot at last capture
  lastCapturedAt DateTime?
  lastSource     FacilityIndicatorSource?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  def        FacilityIndicatorDef     @relation(fields: [defId], references: [id], onDelete: Cascade)
  settlement Settlement               @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  facility   LayerFeature?            @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  points     FacilityIndicatorPoint[]

  // One row per (def, settlement, facility). A companion partial unique index
  // (facilityId IS NULL) added in the migration guarantees a single
  // settlement-level row, since Postgres treats NULLs as distinct here.
  @@unique([defId, settlementId, facilityId])
  @@index([settlementId])
  @@index([facilityId])
}

model FacilityIndicatorPoint {
  id           String                  @id @default(cuid())
  indicatorId  String
  value        Float
  targetValue  Float? // snapshot at capture time
  capturedAt   DateTime
  source       FacilityIndicatorSource
  sourceRefId  String? // PitstopEvent.id, MIS sync log id, etc.
  note         String?
  capturedById String?
  createdAt    DateTime                @default(now())

  indicator  FacilityIndicator      @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  capturedBy User?                  @relation("IndicatorCapture", fields: [capturedById], references: [id], onDelete: SetNull)
  answers    IndicatorPointAnswer[]

  @@index([indicatorId, capturedAt])
}

model MISProviderConfig {
  id             String    @id @default(cuid())
  key            String    @unique // "frappe-creche-mis"
  label          String
  baseUrl        String
  authType       String    @default("frappe") // "frappe" | "api_key" | "basic" | "bearer"
  // Credentials kept behind admin auth — provider-specific JSON
  // e.g. frappe: { apiKey, apiSecret } ; bearer: { token } ; basic: { user, pass }
  credentials    Json?
  isActive       Boolean   @default(true)
  lastSyncedAt   DateTime?
  lastSyncStatus String? // "ok" | "error: <msg>"
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  indicators FacilityIndicatorDef[]
  syncLogs   MISProviderSyncLog[]
}

model MISProviderSyncLog {
  id            String    @id @default(cuid())
  providerId    String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String // "running" | "ok" | "error"
  pointsWritten Int       @default(0)
  message       String?
  details       Json?

  provider MISProviderConfig @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, startedAt])
}

// Binds a checklist item (in a template) to an indicator — when an RP completes
// that activity, a FacilityIndicatorPoint is written from a numeric form field.
model ActivityIndicatorBinding {
  id               String   @id @default(cuid())
  defId            String
  templateSlug     String // GoalTemplateDef.slug — legacy string join, kept during dual-write, dropped in P3
  checklistKey     String // slugified text of the checklist item — legacy string join
  numericField     String   @default("value") // form field name expected on the activity completion payload
  createdAt        DateTime @default(now())
  // P1b: FK-clean anchor. Exactly one of the two is set once backfilled — the tickable thing that
  // feeds this indicator is either a template checklist item OR a catalog-native item.
  checklistDefId   String?
  catalogItemDefId String?

  def            FacilityIndicatorDef  @relation(fields: [defId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: if a checklist/catalog item is deleted, the binding SURVIVES and shows as
  // broken (re-pointable in the graph) rather than being silently destroyed.
  checklistDef   TemplateChecklistDef? @relation(fields: [checklistDefId], references: [id], onDelete: SetNull)
  catalogItemDef CatalogItemDef?       @relation(fields: [catalogItemDefId], references: [id], onDelete: SetNull)

  @@unique([defId, templateSlug, checklistKey])
  @@index([templateSlug, checklistKey])
  @@index([checklistDefId])
  @@index([catalogItemDefId])
}

// Scored checklist items attachable to any indicator def (creche 24-point
// safety tick-list first; water/sanitation later). When a def has active
// items, the RP completion modal renders a Yes/No(/N-A) tick-list instead of
// a bare numeric input and the captured value = count(yes) + count(na).
model IndicatorChecklistItemDef {
  id            String   @id @default(cuid())
  defId         String
  itemKey       String // stable slug per def, e.g. "roof-walls-structural-safety"
  text          String
  category      String? // grouping label in the modal, e.g. "Fire Safety"
  nonNegotiable Boolean  @default(false) // failing pre-fills a follow-up action point
  naAllowed     Boolean  @default(false) // conditional items (well cover, solar); N/A counts compliant
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true) // soft-delete; historical answers preserved
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  def     FacilityIndicatorDef   @relation(fields: [defId], references: [id], onDelete: Cascade)
  answers IndicatorPointAnswer[]

  @@unique([defId, itemKey])
  @@index([defId, sortOrder])
}

// Per-item answer recorded alongside a FacilityIndicatorPoint capture.
model IndicatorPointAnswer {
  id        String   @id @default(cuid())
  pointId   String
  itemDefId String
  answer    String // "yes" | "no" | "na"
  createdAt DateTime @default(now())

  point   FacilityIndicatorPoint    @relation(fields: [pointId], references: [id], onDelete: Cascade)
  itemDef IndicatorChecklistItemDef @relation(fields: [itemDefId], references: [id], onDelete: Restrict)

  @@unique([pointId, itemDefId])
  @@index([itemDefId, answer])
}

// ── Caregiver Practices (creche live-visit quality layer) ─────────────────────
// A dedicated observation layer distinct from the binary FacilityIndicator
// scored-checklist: 3-level taxonomy (category → subcategory → practice), a
// graded 5-value status, exception-based capture (RP flags only deficient
// practices during a visit), and a derived carry-forward loop (a practice
// flagged NeedsImprovement/NotPracticed resurfaces on the creche's next visit).
// Entry is a single "Caregiver practices" catalog item on the creche visit.

enum CaregiverPracticeStatus {
  OK // observed, done correctly
  NeedsImprovement // attempted but incorrect / partial
  NotPracticed // missing entirely
  NotObserved // could not be verified this visit
  NotApplicable // doesn't apply to this creche
}

enum CaregiverPracticeAction {
  FeedbackOnSpot
  RefresherPlanned
  EscalateToSupervisor
}

model CaregiverPracticeCategory {
  id        String   @id @default(cuid())
  code      String   @unique // e.g. "FN"
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  practices CaregiverPractice[]
}

model CaregiverPractice {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. "FN-10"
  categoryId     String
  subcategory    String // grouping label within the category (not a table)
  shortLabel     String // UI label in the drill
  fullText       String // full portal wording
  trainingModule Int? // phase-2 refresher-training demand rollup tag
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category     CaregiverPracticeCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  observations CaregiverPracticeObservation[]

  @@index([categoryId, sortOrder])
  @@index([trainingModule])
}

model CaregiverPracticeObservation {
  id            String                   @id @default(cuid())
  practiceId    String
  facilityId    String // the creche (goal's LayerFeature)
  settlementId  String
  goalId        String
  // Legacy parent Visit PitstopEvent. Kept for existing rows; new /field captures
  // stamp fieldVisitId instead. Exactly one of the two is set per row going forward.
  visitEventId  String? // parent Visit PitstopEvent (legacy /operations)
  fieldVisitId  String? // parent FieldVisit (/field surface)
  status        CaregiverPracticeStatus
  remarks       String?
  action        CaregiverPracticeAction?
  photoUrl      String?
  // Follow-up ActionPoint raised when action = EscalateToSupervisor (phase 2).
  // 1:1 — cleared (SetNull) if the AP is deleted; cancelled if the flag is un-escalated.
  actionPointId String?                  @unique
  capturedById  String
  capturedAt    DateTime                 @default(now())

  practice    CaregiverPractice @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  facility    LayerFeature      @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  settlement  Settlement        @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  goal        Goal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  visit       PitstopEvent?     @relation(fields: [visitEventId], references: [id], onDelete: Cascade)
  fieldVisit  FieldVisit?       @relation(fields: [fieldVisitId], references: [id], onDelete: Cascade)
  capturedBy  User              @relation("CaregiverObservationCapturer", fields: [capturedById], references: [id])
  actionPoint ActionPoint?      @relation(fields: [actionPointId], references: [id], onDelete: SetNull)

  // One row per practice per visit (enables upsert + AP reconciliation).
  // Both nullable — Postgres treats NULLs as distinct, so a row uses exactly one lane.
  @@unique([visitEventId, practiceId])
  @@unique([fieldVisitId, practiceId])
  // Carry-forward: "latest observation per (facility, practice)".
  @@index([facilityId, practiceId, capturedAt])
  @@index([facilityId, status]) // phase-2 command-center facility rollup
  @@index([practiceId, status]) // phase-2 training-module demand
}

// ── Themes ────────────────────────────────────────────────────────────────────

model Theme {
  id          String    @id @default(cuid())
  name        String
  description String?
  color       String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  goals    GoalTheme[]
  pitstops PitstopTheme[]
}

model PitstopTheme {
  pitstopId String
  themeId   String

  pitstop Pitstop @relation(fields: [pitstopId], references: [id], onDelete: Cascade)
  theme   Theme   @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([pitstopId, themeId])
}

model GoalTheme {
  goalId  String
  themeId String

  goal  Goal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@id([goalId, themeId])
}

// ── Geography: City → Zone → Cluster → Settlement ────────────────────────────

model City {
  id               String    @id @default(cuid())
  name             String
  totalSettlements Int       @default(0)
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  zones             Zone[]
  settlements       Settlement[]
  needsGoals        Goal[]         @relation("GoalNeedsCity")
  needsActionPoints ActionPoint[]  @relation("ActionPointNeedsCity")
  users             User[]         @relation("UserCity")
  grantingUnits     GrantingUnit[]
}

// Polygon for this zone is derived live by the `zone_geometry` view
// (ST_Union of every settlement's polygon + 300m buffer around
// centroid-only settlements). See migration
// 20260605010000_derived_cluster_zone_views.
model Zone {
  id        String    @id @default(cuid())
  name      String
  cityId    String?
  leadId    String?
  color     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  city              City?                @relation(fields: [cityId], references: [id], onDelete: SetNull)
  lead              User?                @relation("ZoneLead", fields: [leadId], references: [id], onDelete: SetNull)
  clusters          Cluster[]
  needsGoals        Goal[]               @relation("GoalNeedsZone")
  needsActionPoints ActionPoint[]        @relation("ActionPointNeedsZone")
  needsPitstops     Pitstop[]            @relation("PitstopNeedsZone")
  layerFeatures     LayerFeature[]
  wikiCircles       WikiPracticeCircle[]
}

// Polygon for this cluster is derived live by the `cluster_geometry`
// view (ST_Union of its settlements' polygons + 300m buffer around
// centroid-only settlements). See migration
// 20260605010000_derived_cluster_zone_views.
model Cluster {
  id              String    @id @default(cuid())
  name            String
  zoneId          String
  color           String?
  label           String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  isHealthCluster Boolean   @default(false)
  // Partner that runs this cluster. Added 2026-06-04 as part of the Org
  // migration — previously inferred from each settlement's partner.
  partnerOrgId    String?

  zone              Zone           @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  settlements       Settlement[]
  needsGoals        Goal[]         @relation("GoalNeedsCluster")
  needsActionPoints ActionPoint[]  @relation("ActionPointNeedsCluster")
  needsPitstops     Pitstop[]      @relation("PitstopNeedsCluster")
  layerFeatures     LayerFeature[]
  rps               User[]         @relation("RPClusters")
  partnerOrg        Org?           @relation("ClusterPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)

  @@index([partnerOrgId])
}

model LayerFeature {
  id           String   @id @default(cuid())
  name         String
  layerKey     String // creches | children_centres | youth_centres | resource_centres
  centreType   String?
  // Partner-org FK (added 2026-06-04). The free-text `partner` column it was
  // backfilled from was dropped in 20261103160000_retire_map_partner: all 40
  // values resolved to the org already on the row, and the only ones that
  // differed ("CFAR Creches" → CFAR) differed by a suffix that layerKey
  // already carries.
  partnerOrgId String?
  lat          Float
  lng          Float
  settlementId String?
  clusterId    String?
  zoneId       String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  settlement            Settlement?                    @relation(fields: [settlementId], references: [id], onDelete: SetNull)
  cluster               Cluster?                       @relation(fields: [clusterId], references: [id], onDelete: SetNull)
  zone                  Zone?                          @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  linkedGoals           Goal[]                         @relation("GoalLinkedFacility")
  partnerOrg            Org?                           @relation("LayerFeaturePartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)
  // Per-facility Layer-2 indicators captured against this facility.
  facilityIndicators    FacilityIndicator[]
  caregiverObservations CaregiverPracticeObservation[]

  @@index([partnerOrgId])
}

model Settlement {
  id        String    @id @default(cuid())
  name      String
  clusterId String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Geospatial
  polygon     Json?
  centroidLat Float?
  centroidLng Float?

  // City direct FK — denormalised for fast city-scoped queries (backfilled from cluster→zone→city)
  cityId String?

  // Partner organisation (1:1 — one partner covers this settlement). The legacy
  // MapPartner FK that sat beside this was dropped in
  // 20261103160000_retire_map_partner: it agreed with partnerOrgId on every one
  // of the 270 rows that had both, and the admin API had already stopped
  // writing it (7 settlements had partnerOrgId and no partnerId).
  partnerOrgId String?

  cluster               Cluster                        @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  city                  City?                          @relation(fields: [cityId], references: [id])
  partnerOrg            Org?                           @relation("SettlementPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)
  assessments           SettlementAssessment[]
  profile               SettlementProfile?
  note                  SettlementNote?
  civicData             SettlementCivicData?
  // Needs geography back-relations
  needsGoals            Goal[]                         @relation("GoalNeedsSettlement")
  needsActionPoints     ActionPoint[]                  @relation("ActionPointNeedsSettlement")
  needsPitstops         Pitstop[]                      @relation("PitstopNeedsSettlement")
  goalOutcomes          GoalOutcome[]
  schools               SettlementSchool[]
  healthCentres         SettlementHealthCentre[]
  canteens              SettlementCanteen[]
  bbmpSchools           SettlementBbmpSchool[]
  layerFeatures         LayerFeature[]
  // Layer 2 facility indicators
  facilityIndicators    FacilityIndicator[]
  // Layer 3 programme journeys
  programmeJourneys     ProgrammeJourney[]
  caregiverObservations CaregiverPracticeObservation[]

  @@index([partnerOrgId])
}

// Indira Canteen (Karnataka govt subsidised-meal canteen) mapped to nearby settlements
model IndiraCanteen {
  id        String   @id @default(cuid())
  name      String
  lat       Float
  lng       Float
  kgisCode  String?  @unique // KGISCode from the govt KML — stable external id
  address   String?
  createdAt DateTime @default(now())

  settlements SettlementCanteen[]
}

// Junction: settlement ↔ Indira canteen with haversine distance
model SettlementCanteen {
  id           String @id @default(cuid())
  settlementId String
  canteenId    String
  distanceKm   Float

  settlement Settlement    @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  canteen    IndiraCanteen @relation(fields: [canteenId], references: [id], onDelete: Cascade)

  @@unique([settlementId, canteenId])
}

// BBMP / municipal school. Source: UDISE+ "Know Your School" filtered to
// management = "Local body" for the Bengaluru U North/South education districts.
// Coordinates come from the KGIS school layer, joined on the UDISE code, and are
// NULL where no match exists yet — such rows stay off the map but still report.
model BbmpSchool {
  id             String   @id @default(cuid())
  udiseCode      String   @unique // 11-digit UDISE+ code — the stable external id
  name           String
  lat            Float?
  lng            Float?
  geocodeSource  String? // "kgis" | "google" | "manual" — null when ungeocoded
  category       String?
  management     String?
  urbanLocalBody String?
  lgdWard        String?
  eduBlock       String?
  eduDistrict    String?
  address        String?
  pincode        String?
  status         String?
  createdAt      DateTime @default(now())

  settlements SettlementBbmpSchool[]
}

// Junction: settlement ↔ BBMP school with haversine distance
model SettlementBbmpSchool {
  id           String @id @default(cuid())
  settlementId String
  schoolId     String
  distanceKm   Float

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  school     BbmpSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([settlementId, schoolId])
}

// Government / programme health centre
model HealthCentre {
  id         String   @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  centreType String // CRC | Foundation Health Centre | Government Health Centre | Referral Helpdesk Hospital | Super Speciality Hospital
  notes      String?
  createdAt  DateTime @default(now())

  settlements SettlementHealthCentre[]
}

// Junction: settlement ↔ health centre with haversine distance
model SettlementHealthCentre {
  id             String @id @default(cuid())
  settlementId   String
  healthCentreId String
  distanceKm     Float

  settlement   Settlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  healthCentre HealthCentre @relation(fields: [healthCentreId], references: [id], onDelete: Cascade)

  @@unique([settlementId, healthCentreId])
}

// Government school mapped to nearby settlements
model School {
  id         String   @id @default(cuid())
  name       String
  lat        Float
  lng        Float
  address    String?
  gmapsId    String?  @unique
  schoolType String   @default("Government")
  createdAt  DateTime @default(now())

  settlements SettlementSchool[]
}

// Junction: settlement ↔ school with computed distance
model SettlementSchool {
  id           String @id @default(cuid())
  settlementId String
  schoolId     String
  distanceKm   Float

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([settlementId, schoolId])
}

// Flattened snapshot of the latest SettlementAssessment for fast reads
model SettlementProfile {
  settlementId         String    @id
  totalHouseholds      Int       @default(0)
  children6m3yr        Int       @default(0)
  children4to14        Int       @default(0)
  youth15to21          Int       @default(0)
  elderly60plus        Int       @default(0)
  settlementType       String?
  priorityIssues       String?
  // Addressable need snapshot (latest assessment)
  addressableCreches   Int?
  addressableToilets   Int?
  addressableWaterATMs Int?
  lastAssessmentId     String?
  lastSyncedAt         DateTime?
  updatedAt            DateTime  @updatedAt

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

// ── Quarterly Planning ────────────────────────────────────────────────────────

model Quarter {
  id        String    @id @default(cuid())
  year      Int
  quarter   Int // 1–4
  startDate DateTime
  endDate   DateTime
  focus     String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  goals GoalQuarter[]

  @@unique([year, quarter])
}

model GoalQuarter {
  goalId    String
  quarterId String

  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  quarter Quarter @relation(fields: [quarterId], references: [id], onDelete: Cascade)

  @@id([goalId, quarterId])
}

// ── Legacy / Utility ──────────────────────────────────────────────────────────

model CustomPitstopType {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model PitstopReminderLog {
  id        String   @id @default(cuid())
  pitstopId String
  type      String // "10d" | "3d" | "due"
  sentAt    DateTime @default(now())

  pitstop Pitstop @relation(fields: [pitstopId], references: [id], onDelete: Cascade)

  @@unique([pitstopId, type])
}

model PitstopCheckinLog {
  id         String   @id @default(cuid())
  pitstopId  String   @unique
  lastSentAt DateTime

  pitstop Pitstop @relation(fields: [pitstopId], references: [id], onDelete: Cascade)
}

enum PitstopEventType {
  Meeting
  Visit
  Event
}

model PitstopEvent {
  id                   String             @id @default(cuid())
  title                String
  description          String?
  type                 PitstopEventType   @default(Meeting)
  status               PitstopEventStatus @default(Scheduled)
  scheduledAt          DateTime
  // Frozen at creation, never mutated by reschedule. Delay/SLA are always
  // computed from this date so reschedule cannot launder lateness.
  originalScheduledAt  DateTime
  // Transient "also show this activity on this day's Today list" override.
  // Set by Add-to-today (overdue or future pull-forward). Never changes
  // scheduledAt — purely additive for list visibility. Old values are harmless
  // because the Today query only matches when displayDate equals today.
  displayDate          DateTime?
  endsAt               DateTime?
  location             String?
  createdById          String
  lastUpdatedById      String?
  completedById        String?
  checklistItemId      String?
  // "I have reached" arrival stamp — set on a Visit event when the RP marks arrival at the centre.
  arrivedAt            DateTime?
  arrivedById          String?
  // Groups ticked catalog items (child events) under their parent Visit event. Null on the visit
  // itself and on classic (non-visit) activities.
  visitEventId         String?
  rescheduledFrom      DateTime?
  rescheduleReason     String?
  rescheduleReasonCode String?
  rescheduleCount      Int                @default(0)
  cancellationReason   String?
  completedAt          DateTime?
  deletedAt            DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  // Template provenance — slugified from the template activity's title.
  // templateSlug rides on the parent ChecklistItem (no need to duplicate).
  // Null = manually scheduled activity (sync leaves alone).
  templateKey String?

  createdBy             User                           @relation("PitstopEventCreator", fields: [createdById], references: [id])
  lastUpdatedBy         User?                          @relation("PitstopEventLastUpdater", fields: [lastUpdatedById], references: [id])
  completedBy           User?                          @relation("PitstopEventCompleter", fields: [completedById], references: [id])
  arrivedBy             User?                          @relation("PitstopEventArriver", fields: [arrivedById], references: [id])
  checklistItem         ChecklistItem?                 @relation("ChecklistActivity", fields: [checklistItemId], references: [id], onDelete: SetNull)
  // Visit grouping: a Visit event owns the child events created when its catalog items are ticked.
  visitEvent            PitstopEvent?                  @relation("VisitChildren", fields: [visitEventId], references: [id], onDelete: SetNull)
  childEvents           PitstopEvent[]                 @relation("VisitChildren")
  attendees             PitstopEventAttendee[]
  pitstops              PitstopEventPitstop[]
  followups             PitstopEventFollowup[]
  threads               Thread[]
  // Action points raised from this activity
  actionPoints          ActionPoint[]
  caregiverObservations CaregiverPracticeObservation[]

  // Activities-page + planner queries sort + range-filter on scheduledAt.
  // Partial index (active + non-cancelled) backs the most common UI filter.
  // Full index covers the rest (calendar feed, admin views, audit lookups).
  // See migration 20260604120000_pitstop_event_perf_indexes for the partial
  // index — Prisma can't express WHERE predicates in @@index so it lives
  // only in the migration SQL.
  @@index([scheduledAt])
}

model PitstopEventFollowup {
  id          String                      @id @default(cuid())
  eventId     String
  userId      String
  response    PitstopEventFollowupStatus?
  sentAt      DateTime
  nudgeSentAt DateTime?
  createdAt   DateTime                    @default(now())
  updatedAt   DateTime                    @updatedAt

  event PitstopEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

enum PitstopEventFollowupStatus {
  Done
  No
  Cancelled
  Rescheduled
}

model PitstopEventAttendee {
  id      String @id @default(cuid())
  eventId String
  userId  String
  status  String @default("accepted") // accepted | pending | declined

  event PitstopEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model PitstopEventPitstop {
  id        String @id @default(cuid())
  eventId   String
  pitstopId String

  event   PitstopEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pitstop Pitstop      @relation(fields: [pitstopId], references: [id], onDelete: Cascade)

  @@unique([eventId, pitstopId])
}

model Program {
  id          String    @id @default(cuid())
  title       String
  description String?
  ownerId     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner User          @relation(fields: [ownerId], references: [id])
  goals ProgramGoal[]
}

model ProgramGoal {
  id        String @id @default(cuid())
  programId String
  goalId    String

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  goal    Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([programId, goalId])
}

model PlanItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  date        DateTime
  endDate     DateTime?
  type        String    @default("Note")
  userId      String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pitstops PlanItemPitstop[]
}

model PlanItemPitstop {
  id         String @id @default(cuid())
  planItemId String
  pitstopId  String

  planItem PlanItem @relation(fields: [planItemId], references: [id], onDelete: Cascade)
  pitstop  Pitstop  @relation(fields: [pitstopId], references: [id], onDelete: Cascade)

  @@unique([planItemId, pitstopId])
}

model AppSetting {
  key   String @id
  value String
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Urban Programme Map ───────────────────────────────────────────────────────

model SettlementNote {
  settlementId String   @id
  note         String   @default("")
  updatedAt    DateTime @updatedAt

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

// ── Needs Assessment ──────────────────────────────────────────────────────────

// NeedsDomain is no longer an enum — domain keys are stored as plain strings
// and configured via NeedsFormulaConfig (admin-editable from /settings/needs)

// Admin-configurable formula denominators per domain
model NeedsFormulaConfig {
  domain            String   @id
  /// numerator in "X units per N people". 1 for the legacy single-unit ratio.
  numerator         Float    @default(1)
  denominator       Float?
  description       String?
  label             String?
  color             String   @default("#6b7280")
  domainType        String   @default("count") // "count" | "boolean" | "entitlement" | "civic"
  populationField   String? // "totalHouseholds" | "children6m3yr" | "youth15to21" | "elderly60plus" etc.
  assessmentColumn  String? // column name in SettlementAssessment for "existing" count, e.g. "existingCreches"
  addressableColumn String? // column name in SettlementAssessment for "addressable need", e.g. "addressableCreches"
  civicGroup        String? // for domainType="civic": "borewell" | "toiletConnection" | "toiletFacility" | "waterSupply"
  civicWeightGroup  String? // for domainType="count": multiply populationField by this civic group's need score before dividing by denominator
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  clusterScope      Boolean  @default(false) // legacy — superseded by assessmentLevel
  assessmentLevel   String   @default("settlement") // "settlement" | "cluster" | "zone" | "city"
  linkedSchemeId    String? // for domainType="entitlement" — links to an EntitlementScheme
  staleYellowDays   Int      @default(60) // days since last delivery before showing yellow staleness signal
  staleRedDays      Int      @default(120) // days since last delivery before showing red staleness signal
  updatedAt         DateTime @updatedAt

  linkedScheme EntitlementScheme? @relation("DomainScheme", fields: [linkedSchemeId], references: [id], onDelete: SetNull)
}

// Civic amenity data per settlement from Janadhikara survey
// All % values are per-household percentages (0-100)
model SettlementCivicData {
  settlementId         String   @id
  janaId               Int? // janadhikara slum_id for future syncs
  borewell             Json? // { individual, public, shared, privateTanker, na } — all % of HH
  toiletConnection     Json? // { sewerage, soakPit, noSewerage }
  toiletFacility       Json? // { individual, shared, public, publicPaid, noFacility }
  waterSupply          Json? // { individual, shared, public, privateTanker }
  // Pre-computed need scores (0-100, higher = more need) for aggregation
  borewellNeedScore    Float? // 100 - individual%
  toiletConnNeedScore  Float? // soakPit% + noSewerage%
  toiletFacNeedScore   Float? // 100 - individual%
  waterSupplyNeedScore Float? // 100 - individual%
  syncedAt             DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

// Entitlement schemes (hierarchical — BoCW parent + 14 children)
model EntitlementScheme {
  id          String   @id @default(cuid())
  name        String
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent        EntitlementScheme?     @relation("SchemeHierarchy", fields: [parentId], references: [id])
  children      EntitlementScheme[]    @relation("SchemeHierarchy")
  baselines     EntitlementBaseline[]
  linkedDomains NeedsFormulaConfig[]   @relation("DomainScheme")
  indicators    FacilityIndicatorDef[] @relation("IndicatorScheme")
}

// One row per survey per settlement — versioned (history preserved)
model SettlementAssessment {
  id             String   @id @default(cuid())
  settlementId   String
  assessmentYear Int
  assessedById   String
  assessedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  // Population (drives target calculations)
  totalHouseholds Int @default(0)
  children6m3yr   Int @default(0)
  children4to14   Int @default(0)
  youth15to21     Int @default(0)
  elderly60plus   Int @default(0)

  // Existing infrastructure (gap = target − existing − apf_actuals)
  existingCreches                Int @default(0)
  existingChildrenCentres        Int @default(0)
  existingYouthGroups            Int @default(0)
  existingYouthResourceCentres   Int @default(0)
  existingElderlyKitchens        Int @default(0)
  existingElderlyCentres         Int @default(0)
  existingPalliativeUnits        Int @default(0)
  existingPalliativeCareServices Int @default(0)
  existingReferralSystems        Int @default(0)
  existingCommunityToilets       Int @default(0)
  existingWaterATMs              Int @default(0)

  // Addressable need — field-verified, feasibility-filtered demand
  addressableCreches   Int?
  addressableToilets   Int?
  toiletLandAvailable  Boolean?
  toiletLandType       String? // "Govt" | "Private"
  addressableWaterATMs Int?
  waterATMCurrentCount Int?
  waterATMFeasible     Boolean?

  // Settlement profile (Section 2)
  settlementType    String?
  composition       String?
  predominantGroups String?
  languages         String?
  yearsEstablished  Int?

  // Land & Tenure (Section 3)
  landOwnership      String?
  legalStatus        String?
  hakkupatraEligible Int?

  // Priority issues & notes (Sections 11–12)
  priorityIssues  String?
  enumeratorNotes String?

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  assessedBy User       @relation(fields: [assessedById], references: [id])

  // Civic baseline sections (1-to-1 per assessment)
  roads         RoadBaseline?
  water         WaterBaseline?
  sanitation    SanitationBaseline?
  drainageSewer DrainageSewerBaseline?
  drainageStorm DrainageStormBaseline?
  waste         WasteBaseline?
  electricity   ElectricityBaseline?
  facilities    FacilitiesBaseline?
  safety        SafetyBaseline?

  entitlements EntitlementBaseline[]

  @@index([settlementId, assessedAt])
}

// Section 4 — Roads
model RoadBaseline {
  assessmentId   String  @id
  roadType       String? // CONCRETE|GRAVEL|MUD|NONE
  condition      String? // GOOD|DAMAGED|VERY_POOR
  accessibility  String? // MOTORABLE|TWO_WHEELER|PEDESTRIAN
  unusableInRain Boolean @default(false)
  remarks        String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 5 — Water
model WaterBaseline {
  assessmentId         String  @id
  drinkingSource       String? // PIPED|PUBLIC_TAP|BOREWELL|TANKER|PACKAGED|OTHER
  treatsDrinkingWater  Boolean @default(false)
  treatmentMethod      String?
  waterQuality         String? // GOOD|ACCEPTABLE|POOR
  poorQualityReason    String?
  nonPotableSource     String?
  nonPotableSufficient Boolean @default(true)
  nonPotableIssues     String?
  remarks              String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 6 — Sanitation
model SanitationBaseline {
  assessmentId         String  @id
  individualToiletPct  Float   @default(0)
  sharedToiletPct      Float   @default(0)
  openDefecationPct    Float   @default(0)
  communityToiletCount Int     @default(0)
  toiletSeats          Int     @default(0)
  bathCount            Int     @default(0)
  urinalCount          Int     @default(0)
  toiletsPaid          Boolean @default(false)
  toiletFee            Float?
  toiletCondition      String? // GOOD|FAIR|POOR|NOT_USABLE
  toiletsSufficient    Boolean @default(false)
  sewerConnection      String? // SEWER_LINE|SEPTIC_TANK|OPEN_DRAIN|NONE
  blockageFrequency    String? // FREQUENTLY|OCCASIONALLY|NO_ISSUES
  bathingFacilities    String? // ADEQUATE|LIMITED|NONE
  remarks              String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 7A — Sewer/Wastewater Drainage
model DrainageSewerBaseline {
  assessmentId      String  @id
  disposalType      String? // UNDERGROUND|SEPTIC_INDIVIDUAL|SEPTIC_SHARED|OPEN_DRAINS|NONE
  coverage          String? // MOST|SOME|VERY_FEW|NONE
  condition         String? // GOOD|NEEDS_REPAIR|POOR
  issues            String? // JSON array
  blockageFrequency String? // FREQUENTLY|OCCASIONALLY|RARE
  safeDisposal      Boolean @default(false)
  remarks           String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 7B — Storm Water Drainage
model DrainageStormBaseline {
  assessmentId       String  @id
  drainType          String? // COVERED|OPEN|MIXED|NONE
  drainCondition     String? // CLEAN|PARTIALLY_CLOGGED|FULLY_CLOGGED|DAMAGED
  connectivity       String? // WELL_CONNECTED|PARTIALLY|NOT_CONNECTED
  floodingOccurs     Boolean @default(false)
  floodFrequency     String? // EVERY_RAIN|HEAVY_ONLY|OCCASIONALLY
  floodLevel         String? // ANKLE|KNEE|ABOVE_KNEE
  stagnationDuration String? // UNDER_1H|1_6H|OVER_6H|OVER_1D
  floodCauses        String? // JSON array
  floodLocations     String?
  remarks            String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 8 — Solid Waste
model WasteBaseline {
  assessmentId       String  @id
  collectionType     String? // DOOR_TO_DOOR|COMMUNITY_BINS|NONE
  frequency          String? // DAILY|ALTERNATE|WEEKLY|IRREGULAR
  informalDumpsCount Int     @default(0)
  remarks            String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 9 — Electricity & Street Lighting
model ElectricityBaseline {
  assessmentId           String  @id
  hhWithConnection       Int     @default(0)
  hhWithoutConnection    Int     @default(0)
  avgHoursPerDay         Float?
  connectionTypes        String? // JSON array
  supplyNature           String? // REGULAR|FREQUENT_CUTS|VERY_UNRELIABLE
  totalStreetlights      Int     @default(0)
  functionalStreetlights Int     @default(0)
  streetlightAdequacy    String? // ADEQUATE|FEW|NONE
  priorityStreets        String?
  remarks                String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 10 — Community Facilities
model FacilitiesBaseline {
  assessmentId      String  @id
  anganwadiCount    Int     @default(0)
  hasSchool         Boolean @default(false)
  hasPHC            Boolean @default(false)
  hasNammaClinic    Boolean @default(false)
  hasRationShop     Boolean @default(false)
  hasCommunityHall  Boolean @default(false)
  hasLibrary        Boolean @default(false)
  hasPark           Boolean @default(false)
  hasPlayground     Boolean @default(false)
  distanceToSchool  Float?
  distanceToHealth  Float?
  distanceToBusStop Float?
  remarks           String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Section 11 — Safety
model SafetyBaseline {
  assessmentId       String  @id
  blindSpotsCount    Int     @default(0)
  blindSpotTypes     String? // JSON array
  activitiesObserved String? // JSON array
  remarks            String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
}

// Entitlement tracking per scheme per assessment
model EntitlementBaseline {
  id                 String  @id @default(cuid())
  assessmentId       String
  schemeId           String
  eligibleHouseholds Int     @default(0)
  enrolledHouseholds Int     @default(0) // NGO-assisted enrollments (from scheme_report / Frappe)
  surveyEnrolled     Int? // Pre-existing at survey time (from Janadhikara household survey XLSX)
  notes              String?

  assessment SettlementAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  scheme     EntitlementScheme    @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, schemeId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model GoalTemplateDef {
  id                     String   @id @default(cuid())
  slug                   String   @unique
  name                   String
  description            String   @default("")
  category               String
  icon                   String   @default("🎯")
  needsDomain            String?
  linkedFacilityLayerKey String? // e.g. "creches" | "children_centres" | "youth_centres" — shows facility picker on goal creation
  sortOrder              Int      @default(0)
  parameters             Json     @default("[]")
  pitstops               Json     @default("[]") // legacy source of truth; shredded into pitstopDefs (P1b), dropped in P3
  isActive               Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  pitstopDefs TemplatePitstopDef[]
}

// Domain-default visit catalog for LIVE centres. One (or a few) per programme domain.
// `categories` holds the menu hierarchy authored in the admin UI (parallel to GoalTemplateDef):
//   [{ key, label, items: [{ key, text, completionType, blocksSignoff }] }]
// Frozen into CentreCatalog.snapshot when a centre goes live (Budget cost snapshot/override pattern).
model CatalogTemplateDef {
  id                   String   @id @default(cuid())
  slug                 String   @unique
  name                 String
  needsDomain          String? // matches Goal.needsDomain — the domain this catalog is the default for
  categories           Json     @default("[]") // legacy source of truth; shredded into categoryDefs (P1b), dropped in P3
  // Default visit cadence seeded onto a centre at go-live. period ∈ {"week","month"}.
  defaultCadenceCount  Int?
  defaultCadencePeriod String?
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  categoryDefs CatalogCategoryDef[]
}

// Per-centre live catalog: a frozen snapshot of the domain default + sparse per-centre overrides,
// plus this centre's visit cadence. One per live Goal.
model CentreCatalog {
  id            String   @id @default(cuid())
  goalId        String   @unique
  catalogSlug   String // the CatalogTemplateDef.slug this was seeded from
  snapshot      Json     @default("{}") // frozen domain-default categories at go-live
  overrides     Json     @default("{}") // sparse per-centre add/remove/edit; effective menu = snapshot ⊕ overrides
  // Visit cadence (count per period). period ∈ {"week","month"}. Seeded from CatalogTemplateDef, overridable.
  cadenceCount  Int?
  cadencePeriod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
}

// Approval record for catalog items added ad-hoc by an RP (visible to all, pending supervisor
// approval). Managers add items directly with status "approved". Mirrors ReportSlotStatus lifecycle.
model CatalogItemApproval {
  id        String   @id @default(cuid())
  goalId    String
  itemKey   String // the catalog item key (within CentreCatalog.overrides) this approval governs
  addedById String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal    Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  addedBy User @relation("CatalogItemAdder", fields: [addedById], references: [id])

  @@unique([goalId, itemKey])
}

// ─── Relational config graph (P1b) ────────────────────────────────────────────
// Shredded from GoalTemplateDef.pitstops / CatalogTemplateDef.categories JSON so the config
// becomes a real ERD with FK integrity. Populated additively (dual-write) alongside the JSON;
// reads cut over in P2, JSON columns dropped in P3. `key` stays as the stable slug (matches the
// JSON slug) so runtime materialisation + external bindings keep working during the transition.

model TemplatePitstopDef {
  id           String   @id @default(cuid())
  templateId   String
  order        Int      @default(0)
  key          String // stable slug within template (matches DbPitstop.key)
  title        String
  type         String   @default("Discussion")
  notes        String   @default("")
  slaDays      Int      @default(0)
  startSlaDays Int      @default(0)
  recurrence   String   @default("None")
  repeatCount  Int      @default(1)
  progressTag  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  template  GoalTemplateDef        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  checklist TemplateChecklistDef[]

  @@unique([templateId, key])
  @@index([templateId, order])
}

model TemplateChecklistDef {
  id             String   @id @default(cuid())
  pitstopDefId   String
  order          Int      @default(0)
  key            String // stable slug within template (matches DbChecklistItem.key / ChecklistItem.key)
  text           String
  completionType String   @default("Activity")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pitstop           TemplatePitstopDef         @relation(fields: [pitstopDefId], references: [id], onDelete: Cascade)
  activities        TemplateActivityDef[]
  // Real FK targets that replace the (templateSlug, checklistKey) string joins:
  catalogItems      CatalogItemDef[]           @relation("CatalogItemChecklist")
  indicatorBindings ActivityIndicatorBinding[]
  journeyOutcomes   ProgrammeJourneyOutcome[]

  @@unique([pitstopDefId, key])
  @@index([pitstopDefId, order])
}

model TemplateActivityDef {
  id             String   @id @default(cuid())
  checklistDefId String
  order          Int      @default(0)
  key            String // stable slug within checklist (matches DbActivity.key / PitstopEvent.templateKey)
  title          String
  completionType String   @default("Activity")
  dayOffset      Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  checklist TemplateChecklistDef @relation(fields: [checklistDefId], references: [id], onDelete: Cascade)

  @@unique([checklistDefId, key])
  @@index([checklistDefId, order])
}

model CatalogCategoryDef {
  id        String   @id @default(cuid())
  catalogId String
  order     Int      @default(0)
  key       String
  label     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  catalog CatalogTemplateDef @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  items   CatalogItemDef[]

  @@unique([catalogId, key])
  @@index([catalogId, order])
}

model CatalogItemDef {
  id              String   @id @default(cuid())
  categoryDefId   String
  order           Int      @default(0)
  key             String
  text            String
  completionType  String   @default("Activity")
  blocksSignoff   Boolean  @default(true)
  // Real FK replacing CatalogItem.ref.(templateSlug, checklistKey). Null = catalog-native/free-text
  // item (its own concept). Set = this item TAGS an existing template checklist item.
  checklistDefId  String?
  // The (templateSlug, checklistKey) this item MATERIALISES on a visit (from CatalogItem.ref). Kept
  // even when checklistDefId is null (catalog-native), so a binding created against this item can set
  // the legacy string keys that runtime capture still reads. Null = free-text item with no ref.
  refTemplateSlug String?
  refChecklistKey String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category          CatalogCategoryDef         @relation(fields: [categoryDefId], references: [id], onDelete: Cascade)
  checklist         TemplateChecklistDef?      @relation("CatalogItemChecklist", fields: [checklistDefId], references: [id], onDelete: SetNull)
  // A catalog-native item can itself be an indicator/outcome anchor (e.g. creche Caregiver Practices):
  indicatorBindings ActivityIndicatorBinding[]
  journeyOutcomes   ProgrammeJourneyOutcome[]

  @@unique([categoryDefId, key])
  @@index([categoryDefId, order])
}

// De-hardcoded display labels for behavior-bearing enums. `code` is the STABLE enum value that code
// branches on (never edited); only `label`/`color`/`meta`/order are admin-editable. One row per
// (enumKey, code). Reusable for any enum whose labels should be editable without a code change.
model EnumLabelConfig {
  id        String   @id @default(cuid())
  enumKey   String // e.g. "CaregiverPracticeStatus"
  code      String // the enum value, e.g. "OK" — stable behavior key
  label     String
  color     String? // optional tailwind class or hex
  meta      Json     @default("{}") // enum-specific flags, e.g. { flag: true }
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enumKey, code])
  @@index([enumKey, sortOrder])
}

model UserLoginEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String   @default("credentials")
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Admin-configurable registry of facility layer types shown in template builder + goal wizard
model FacilityLayerConfig {
  id          String   @id @default(cuid())
  layerKey    String   @unique
  label       String
  color       String   @default("#6366f1")
  needsDomain String? // links to NeedsFormulaConfig.domain — ties this layer to a field-coverage need
  // Editable centre-type suggestions for this layer (de-hardcoded from map-features CENTRE_TYPES).
  centreTypes Json     @default("[]")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Budget Tool ──────────────────────────────────────────────────────────────

// BudgetDomain is no longer an enum — domain keys are plain strings
// configured via BudgetDomainConfig (admin-editable from /admin).

model BudgetDomainConfig {
  id               String   @id @default(cuid())
  city             String   @default("Bangalore")
  key              String // stored in domain fields, e.g. "Children"
  label            String // display name, e.g. "Elderly + Community Kitchen"
  description      String?
  position         Int      @default(0)
  isActive         Boolean  @default(true)
  // For per-beneficiary cost analysis
  beneficiaryLabel String? // e.g. "Children", "Youth enrolled"
  beneficiaryVar   String? // programme input key: "nCLCs", "nElderly", "nCreches", "nSettlements"
  beneficiaryMult  Float    @default(1) // multiply beneficiaryVar by this
  createdAt        DateTime @default(now())

  @@unique([city, key])
  @@index([city, position])
}

enum BudgetStatus {
  draft
  final
  approved
  /// Terminal. Set by the closure flow, never by hand: a closed grant's
  /// figures are frozen into GrantClosure and must not drift afterwards.
  closed
}

enum BudgetPartnerEditState {
  closed
  open
  submitted
}

enum ReportFrequency {
  monthly
  bi_monthly
  quarterly
  half_yearly
  annual
}

enum ReportSlotStatus {
  pending
  submitted
  under_review
  sent_back
  approved
}

enum ReallocationStatus {
  pending
  approved
  rejected
}

enum ReallocationDuration {
  remaining_year
  full_grant
  custom
  one_time
}

enum InflationType {
  Salary
  Other
  Nil
}

enum BudgetSection {
  salary
  capex
  travel
  programme
  admin_salary
  admin_other
  additional
}

model Budget {
  id                 String                  @id @default(cuid())
  name               String
  partnerId          String
  partner            User                    @relation("BudgetPartner", fields: [partnerId], references: [id])
  // Grantee org this budget belongs to (spans many budgets). Distinct from
  // partnerId (the User who created it). Null on legacy rows until assigned.
  grantPartnerId     String?
  grantPartner       GrantPartner?           @relation(fields: [grantPartnerId], references: [id], onDelete: SetNull)
  domains            String[]
  city               String                  @default("Bangalore") // legacy label; grantingUnit is authoritative
  // Which office / thematic team / ops team makes and manages this grant.
  grantingUnitId     String?
  grantingUnit       GrantingUnit?           @relation(fields: [grantingUnitId], references: [id], onDelete: SetNull)
  // The colleague accountable for this grant — who chases the partner, reviews
  // the reports, gets the reminders. Distinct from `partnerId` (whoever happened
  // to click create) and from `grantingUnitId` (the team, not the person).
  grantLeadId        String?
  grantLead          User?                   @relation("BudgetGrantLead", fields: [grantLeadId], references: [id], onDelete: SetNull)
  // years is kept for backward compat; horizonMonths is the source of truth.
  // years = ceil(horizonMonths / 12) is maintained at write time so list/select
  // queries that read `years` keep working without a sweep.
  years              Int                     @default(1)
  horizonMonths      Int                     @default(12)
  // Where the pro-rated stub sits when horizonMonths isn't a whole number of
  // years: "end" (default — final band is partial) or "start" (Year 1 partial,
  // e.g. a project starting mid-year).
  partialPosition    String                  @default("end")
  // When true, the budget is split across delivery partners (see
  // BudgetDeliveryPartner). Lines carry deliveryPartnerId; null = shared/master.
  isMultiPartner     Boolean                 @default(false)
  applyInflation     Boolean                 @default(true)
  // Per-budget inflation rates as percentages (e.g. 10 = 10%). Defaults track
  // the previously hard-coded values in lib/budget-generator.ts.
  inflationSalaryPct Float                   @default(10)
  inflationOtherPct  Float                   @default(5)
  inflationNilPct    Float                   @default(0)
  // Per-budget cost customisation. Sparse map of CostRegistry.itemKey → value
  // that the partner edited at create time; the snapshot is the full registry
  // view at create time and is what the generator merges overrides on top of.
  // Snapshot lets future "regenerate" or "scale up" actions reproduce the
  // partner's basis even if the registry has changed.
  costOverrides      Json                    @default("{}")
  costSnapshot       Json                    @default("{}")
  // Set when the budget was created by importing a filled Excel template rather
  // than the parametric generator. Its lines carry hand edits, so a "regenerate
  // from inputs" action must confirm before overwriting them.
  importedAt         DateTime?
  status             BudgetStatus            @default(draft)
  // Grant-making stage: whether the grantee may edit this draft. Orthogonal to
  // `status` — a budget is only ever shared while it is still a draft, and
  // finalise/approve refuse until this is back to `closed`.
  partnerEditState   BudgetPartnerEditState  @default(closed)
  partnerSharedAt    DateTime?
  partnerSubmittedAt DateTime?
  partnerEditedAt    DateTime?
  // Send-back round, incremented each time the lead returns the draft, so
  // BudgetLineNote threads from separate iterations stay distinguishable.
  partnerRound       Int                     @default(0)
  // The lines as they stood when shared — the basis for the review diff.
  partnerBaseline    Json?
  inputs             BudgetInputs?
  lines              BudgetLine[]
  lineNotes          BudgetLineNote[]
  deliveryPartners   BudgetDeliveryPartner[]
  reportConfig       BudgetReportConfig?
  reportSlots        BudgetReportSlot[]
  reports            BudgetReport[]
  borrowingsFrom     GrantBorrowing[]        @relation("BorrowingFrom")
  borrowingsTo       GrantBorrowing[]        @relation("BorrowingTo")
  // After-school centre this budget belongs to (nullable — regular budgets don't).
  schoolPlan         SchoolPlan?             @relation("SchoolBudget")

  // ── Grant lifecycle ───────────────────────────────────────────────────────
  decisions          GrantDecision[]
  agreement          GrantAgreement?
  tranches           GrantTranche[]
  disbursements      Disbursement[]
  closure            GrantClosure?
  // Closures whose unspent balance was carried forward INTO this budget.
  closureAdjustments GrantClosure[]          @relation("ClosureAdjustment")
  documents          GrantDocument[]
  results            GrantResult[]
  proposal           Proposal?
  risks              Risk[]
  fundedGoals        Goal[]                  @relation("GoalFundingBudget")
  fundedActionPoints ActionPoint[]           @relation("ActionPointFundingBudget")
  roleAssignments    GrantRoleAssignment[]
  assessments        GrantAssessment[]

  // ── Renewal lineage ───────────────────────────────────────────────────────
  // The grant this one continues. Renewal is the normal shape of grant-making
  // in a long-term portfolio, and without this every grant looks like a first
  // grant — so an appraisal cannot see what already happened with this partner.
  // Distinct from GrantClosure.adjustedIntoBudgetId: that carries MONEY
  // forward, this carries the RELATIONSHIP forward, and they need not agree.
  renewsBudgetId     String?                 @unique
  renews             Budget?                 @relation("BudgetRenewal", fields: [renewsBudgetId], references: [id], onDelete: SetNull)
  renewedBy          Budget?                 @relation("BudgetRenewal")
  /// How this grant stands to what came before. Null on legacy rows, which is
  /// honest: we do not know, and defaulting them to `new` would assert that
  /// every historic grant was a first grant.
  continuity         GrantContinuity?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  // ── Portfolio-comparables metadata (approvals wizard, Step 5) ─────────────
  // All nullable so existing rows survive the migration. Populated going
  // forward via the budget creation/edit UI + a one-off backfill for the
  // approved corpus. Enables the "cost per beneficiary vs 2-4 similar past
  // grants" section on the approval doc.
  // theme: coarse programme category (e.g. nutrition, early_learning, wash).
  theme                String?
  // interventionModel: direct / capacity / advocacy / livelihoods.
  interventionModel    String?
  // beneficiariesPerYear: distinct people the programme reaches per year;
  // used as the divisor for cost-per-beneficiary.
  beneficiariesPerYear Int?
  // approvedAt / approvedAmount: filled when the approval meeting signs off,
  // so comparables can restrict to actually-approved (vs draft) budgets.
  approvedAt           DateTime?
  approvedAmount       Float?

  @@index([partnerId])
  @@index([grantPartnerId])
  @@index([grantingUnitId])
  @@index([grantLeadId])
  @@index([city, domains, interventionModel, approvedAt])
}

/// Who makes and manages a grant: a focus-geography office, a travelling thematic
/// team, or an operational team running programmes directly. Deliberately distinct
/// from `City`, which is the operational geography owning zones and settlements —
/// thematic teams have no polygon and must not be forced into one.
///
/// `registryCity` is which city's CostRegistry / LineTemplate / BudgetDomainConfig
/// rows this unit generates budgets from. It turns the hardcoded
/// `city === "Others" ? "Bangalore"` fallback, repeated across the portal, into
/// data — so a new unit can be added without touching code.
model GrantingUnit {
  id           String         @id @default(cuid())
  name         String         @unique
  kind         String         @default("geo") // geo | thematic | operational
  registryCity String         @default("Bangalore")
  /// Optional link to the operational geography, where one exists.
  cityId       String?
  city         City?          @relation(fields: [cityId], references: [id], onDelete: SetNull)
  parentId     String?
  parent       GrantingUnit?  @relation("GrantingUnitParent", fields: [parentId], references: [id], onDelete: SetNull)
  children     GrantingUnit[] @relation("GrantingUnitParent")
  isActive     Boolean        @default(true)
  sortOrder    Int            @default(0)
  createdAt    DateTime       @default(now())

  budgets  Budget[]
  partners GrantPartner[]
  // Grant-ERP: unit-scoped authority rules, document requirements and calls.
  authorityRules       AuthorityRule[]
  documentRequirements GrantDocumentRequirement[]
  fundingWindows       FundingWindow[]

  @@index([isActive, sortOrder])
}

// A grantee organisation (e.g. "CFAR", "Sampark"). Spans many budgets/grants so
// the dashboard can aggregate approved amounts + utilisation per partner. Scoped
// to a GrantingUnit so the same name can exist independently under each unit.
model GrantPartner {
  id String @id @default(cuid())
  /// Partner identity. Org (kind="partner") is the one registry every portal
  /// resolves a partner through — due diligence, budgets and the review portal
  /// included. A GrantPartner row is no longer an identity of its own: it is
  /// this org's *grant relationship* with one granting unit, so the same
  /// organisation granting under both Bangalore and Chennai is one Org and two
  /// relationships. Restrict, not SetNull: an org that holds grants cannot be
  /// hard-deleted out from under them — archive it (Org.archivedAt) instead.
  orgId String
  org   Org    @relation("GrantPartnerOrg", fields: [orgId], references: [id], onDelete: Restrict)
  /// Denormalised labels, kept in step with `org` by the registry layer
  /// (lib/partners/registry.ts). Read `org.name` for display; these exist so
  /// historical exports and the dashboard's group-by keep working unchanged.
  name                 String
  city                 String                  @default("Bangalore") // legacy label; grantingUnit is authoritative
  grantingUnitId       String?
  grantingUnit         GrantingUnit?           @relation(fields: [grantingUnitId], references: [id], onDelete: SetNull)
  notes                String?
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  logins               GrantPartnerUser[]
  budgets              Budget[]
  schoolPlansAsAnchor  SchoolPlan[]            @relation("SchoolPlanAnchorPartner")
  deliveryPartnerRoles BudgetDeliveryPartner[]

  @@unique([grantingUnitId, orgId])
  @@unique([grantingUnitId, name])
  @@index([city])
  @@index([grantingUnitId])
  @@index([orgId])
}

// Login accounts for a grantee organisation (Users with role "partner"). A
// grantee is an organisation, not a person: the finance officer who files the
// report and the director who signs the declaration are two people, and a
// handover shouldn't need an admin.
//
// The login attaches to the Org, not to one GrantPartner row. It used to hang
// off grantPartnerId, which quietly capped a grantee at one granting unit: an
// org granting under both Bangalore and Chennai had two GrantPartner rows, the
// login could point at only one of them, and its budgets under the other unit
// were invisible. Resolving to an org instead gives the session every grant
// relationship that org holds (see lib/budget/partnerAccess.ts).
//
// The reverse stays single: userId is unique, so a login belongs to exactly one
// grantee org. A person straddling two grantees would break every access check
// downstream.
model GrantPartnerUser {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation("PartnerLoginOrg", fields: [orgId], references: [id], onDelete: Cascade)
  /// Legacy pointer at one grant relationship, kept nullable so historical rows
  /// still say which unit the login was first set up under. Never read for
  /// access — orgId is authoritative.
  grantPartnerId String?
  grantPartner   GrantPartner? @relation(fields: [grantPartnerId], references: [id], onDelete: SetNull)
  userId         String        @unique
  user           User          @relation("PartnerLogin", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([orgId])
  @@index([grantPartnerId])
}

enum GrantBorrowingStatus {
  outstanding
  partially_reimbursed
  reimbursed
}

// Cross-grant borrowing: a partner spends one grant's cash on another grant's
// work (disbursement timing), reimbursing later. Distinct from
// BudgetReallocationRequest, which moves money only WITHIN one budget. Net
// position as of any date = Σ amount(borrowedOn ≤ D) − Σ repayment(repaidOn ≤ D).
model GrantBorrowing {
  id           String                    @id @default(cuid())
  fromBudgetId String // lender grant (money came from)
  toBudgetId   String // borrower grant (work belonged to)
  fromBudget   Budget                    @relation("BorrowingFrom", fields: [fromBudgetId], references: [id], onDelete: Cascade)
  toBudget     Budget                    @relation("BorrowingTo", fields: [toBudgetId], references: [id], onDelete: Cascade)
  amount       Float
  borrowedOn   DateTime
  reason       String?
  status       GrantBorrowingStatus      @default(outstanding)
  createdById  String?
  createdAt    DateTime                  @default(now())
  repayments   GrantBorrowingRepayment[]

  @@index([fromBudgetId])
  @@index([toBudgetId])
}

// Partial repayments of a borrowing over time — kept as rows so the net
// outstanding position is accurate as of any point in time.
model GrantBorrowingRepayment {
  id          String         @id @default(cuid())
  borrowingId String
  borrowing   GrantBorrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  amount      Float
  repaidOn    DateTime
  note        String?

  @@index([borrowingId])
}

model BudgetInputs {
  id                        String @id @default(cuid())
  budgetId                  String @unique
  budget                    Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  nSettlements              Int    @default(0)
  nClusters                 Int    @default(0)
  nCLCs                     Int    @default(0)
  clcRentPerMonth           Int    @default(0)
  nYRCs                     Int    @default(0)
  yrcRentPerMonth           Int    @default(0)
  nElderlyCentres           Int    @default(0)
  nElderly                  Int    @default(0)
  elderlyCentreRentPerMonth Int    @default(0)
  cosPerCluster             Int    @default(2)
  rcRentPerMonth            Int    @default(0)
  nCreches                  Int    @default(0)
  crecheRentPerMonth        Int    @default(0)
  extraInputs               Json   @default("{}") // custom programme inputs added via admin
}

model BudgetLine {
  id                       String                      @id @default(cuid())
  budgetId                 String
  budget                   Budget                      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  // Delivery-partner this line belongs to in a multi-partner budget. null =
  // shared / cross-cutting (Master tab). SetNull so removing a partner leaves
  // its lines as shared rather than deleting them.
  deliveryPartnerId        String?
  deliveryPartner          BudgetDeliveryPartner?      @relation(fields: [deliveryPartnerId], references: [id], onDelete: SetNull)
  domain                   String?
  section                  BudgetSection
  position                 Int
  description              String
  costCategory             InflationType
  unitType                 String                      @default("")
  isAutoGenerated          Boolean                     @default(true)
  salaryHint               String?
  notes                    String?
  templateKey              String? // links back to LineTemplate.templateKey for cost-driver trail in exports
  y1Units                  Float                       @default(0)
  y1UnitCost               Float                       @default(0)
  y1AllocPct               Float                       @default(1)
  y1Total                  Float                       @default(0)
  y2Units                  Float                       @default(0)
  y2UnitCost               Float                       @default(0)
  y2AllocPct               Float                       @default(1)
  y2Total                  Float                       @default(0)
  y3Units                  Float                       @default(0)
  y3UnitCost               Float                       @default(0)
  y3AllocPct               Float                       @default(1)
  y3Total                  Float                       @default(0)
  y4Units                  Float                       @default(0)
  y4UnitCost               Float                       @default(0)
  y4AllocPct               Float                       @default(1)
  y4Total                  Float                       @default(0)
  y5Units                  Float                       @default(0)
  y5UnitCost               Float                       @default(0)
  y5AllocPct               Float                       @default(1)
  y5Total                  Float                       @default(0)
  isReallocation           Boolean                     @default(false)
  sourceReallocationId     String?
  // Timing profile for period-budget apportionment in reports.
  //   monthly  → straight-line yearTotal/12 × monthsInPeriod (default).
  //   one_time → full yearTotal lands in plannedMonths[0] (1..12 of grant year).
  //   seasonal → yearTotal split evenly across plannedMonths (≥ 2 entries).
  cadence                  BudgetLineCadence           @default(monthly)
  plannedMonths            Int[]                       @default([])
  // Per-line "working": the component breakup this line's unit cost derives
  // from. Empty until the line's cost is authored/edited — until then the UI
  // falls back to the registry item's components. derivation mirrors the
  // registry's free-text note.
  derivation               String?
  // false = the components are the standard registry working frozen at
  // generation ("standard, as generated"). true = the working was edited on
  // this budget (a budget-specific override).
  workingCustomised        Boolean                     @default(false)
  components               BudgetLineComponent[]
  costHistory              BudgetLineCostHistory[]
  reportLines              BudgetReportLine[]
  reallocationRequestsFrom BudgetReallocationRequest[] @relation("ReallocationFrom")
  reallocationRequestsTo   BudgetReallocationRequest[] @relation("ReallocationTo")
  reportLineNotes          BudgetReportLineNote[]
  lineNotes                BudgetLineNote[]
  // Optimistic-concurrency token. The editor seeds its rows once and never
  // re-syncs, so a second writer — the grantee on a shared draft, or another
  // login from the same org — would otherwise silently overwrite.
  updatedAt                DateTime                    @default(now()) @updatedAt

  @@index([budgetId, position])
  @@index([deliveryPartnerId])
}

// Frozen per-budget-line component breakup (the line's own "working"). Created
// when a line's cost is authored/edited; its rollup is the line's base unit
// cost. Independent of CostRegistryComponent so budgets keep their working even
// as the registry drifts.
model BudgetLineComponent {
  id           String     @id @default(cuid())
  budgetLineId String
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  label        String
  spec         String?
  qty          Float      @default(1)
  unitCost     Float      @default(0)
  updatedAt    DateTime   @updatedAt

  @@index([budgetLineId, position])
}

// Append-only change log for a budget line's base (Year-1) unit cost.
model BudgetLineCostHistory {
  id           String     @id @default(cuid())
  budgetLineId String
  budgetLine   BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  oldCost      Float?
  newCost      Float?
  source       String? // "line edit" | "working editor"
  changedById  String?
  changedAt    DateTime   @default(now())

  @@index([budgetLineId, changedAt])
}

// A delivery/implementing partner sharing a multi-partner budget. Distinct from
// Budget.partnerId (the creator user). Each holds its own programme inputs (its
// slice of the totals) and an explicit % of shared/cross-cutting costs
// (sharedPct across all partners should sum to 100).
model BudgetDeliveryPartner {
  id             String        @id @default(cuid())
  budgetId       String
  budget         Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  // Registry link — same GrantPartner registry backing Budget.grantPartnerId.
  // Nullable so pre-link rows (free-text names) survive the migration until
  // backfilled. City is enforced to match Budget.city in the server actions.
  grantPartnerId String?
  grantPartner   GrantPartner? @relation(fields: [grantPartnerId], references: [id], onDelete: SetNull)
  // Denormalised label — kept for display and for rows without a registry link.
  name           String
  sortOrder      Int           @default(0)
  sharedPct      Float         @default(0)
  inputs         Json          @default("{}")
  lines          BudgetLine[]

  @@index([budgetId])
  @@index([grantPartnerId])
}

enum BudgetLineCadence {
  monthly
  one_time
  seasonal
}

model BudgetReportConfig {
  id             String          @id @default(cuid())
  budgetId       String          @unique
  budget         Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  frequency      ReportFrequency
  grantStartDate DateTime
  grantEndDate   DateTime
  dueAfterDays   Int             @default(30)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model BudgetReportSlot {
  id         String           @id @default(cuid())
  budgetId   String
  budget     Budget           @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  slotNumber Int
  grantYear  Int
  periodFrom DateTime
  periodTo   DateTime
  dueDate    DateTime
  status     ReportSlotStatus @default(pending)
  report     BudgetReport?
  createdAt  DateTime         @default(now())

  reminderLogs BudgetReportReminderLog[]
  tranches     GrantTranche[]
  resultValues GrantResultValue[]
  assessments  GrantAssessment[]

  @@unique([budgetId, slotNumber])
  @@index([budgetId, grantYear])
  @@index([status, dueDate])
}

/// One row per (slot, recipient, threshold, channel) the reminder cron has
/// already fired, so a re-run on the same day is a no-op. Mirrors
/// PitstopReminderLog, but keyed by recipient too: a slot reminds both the
/// grantee organisation and the internal grant lead.
model BudgetReportReminderLog {
  id      String           @id @default(cuid())
  slotId  String
  slot    BudgetReportSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId  String
  type    String // "10d" | "3d" | "due" | "overdue7"
  channel String // "inApp" | "push" | "email"
  status  String // "sent" | "skipped" | "failed"
  error   String?
  sentAt  DateTime         @default(now())

  @@unique([slotId, userId, type, channel])
  @@index([slotId])
}

model BudgetReport {
  id                       String                      @id @default(cuid())
  slotId                   String                      @unique
  slot                     BudgetReportSlot            @relation(fields: [slotId], references: [id], onDelete: Cascade)
  budgetId                 String
  budget                   Budget                      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  openingBalance           Float                       @default(0)
  tranchesReceived         Float                       @default(0)
  interestEarned           Float                       @default(0)
  bankBalance              Float                       @default(0)
  fdBalance                Float                       @default(0)
  cashInHand               Float                       @default(0)
  advances                 Float                       @default(0)
  receivables              Float                       @default(0)
  payables                 Float                       @default(0)
  bankStatementUrl         String?
  bankStatementParsed      Json?
  partnerNotes             String?
  reviewerNotes            String?
  submittedAt              DateTime?
  approvedAt               DateTime?
  // Finance Declaration (legal affirmation captured at submit). Snapshot + hash
  // freeze exactly what was affirmed; identity/ip/ua are the audit trail; the
  // signed+sealed scan is the letterhead artifact. declarationAcceptedById is a
  // plain id (no FK) so the record survives user renames/deletes.
  declarationAcceptedAt    DateTime?
  declarationAcceptedById  String?
  declarationSnapshot      Json?
  declarationHash          String?
  declarationIp            String?
  declarationUserAgent     String?
  declarationSignedScanUrl String?
  lines                    BudgetReportLine[]
  reallocationRequests     BudgetReallocationRequest[]
  fdDetails                BudgetReportFd[]
  /// Payments reconciled against this report's period.
  reconciledDisbursements  Disbursement[]              @relation("DisbursementReconciliation")
  narrative                BudgetReportNarrative?
  lineNotes                BudgetReportLineNote[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([budgetId])
}

// One row per fixed deposit held during the reporting period, in the APF
// "Format for FD details" layout. fdBalance on BudgetReport is kept in sync as
// the sum of closingBalance across these rows.
model BudgetReportFd {
  id               String       @id @default(cuid())
  reportId         String
  report           BudgetReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  sortOrder        Int          @default(0)
  bankName         String       @default("")
  fdrNumber        String       @default("") // FDR / receipt number
  faceValue        Float        @default(0)
  maturityValue    Float        @default(0)
  cumulative       Boolean      @default(true) // Cumulative vs Non-Cumulative
  doi              DateTime? // Date of Investment
  dom              DateTime? // Date of Maturity (per FD terms)
  roi              Float        @default(0) // Rate of Interest (%)
  openingBalance   Float        @default(0)
  interestAccrued  Float        @default(0)
  tds              Float        @default(0)
  interestReceived Float        @default(0)
  maturedAmount    Float        @default(0) // Matured during the period
  maturityDate     DateTime? // Actual maturity/redemption date in period
  closingBalance   Float        @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([reportId])
}

model BudgetReallocationRequest {
  id              String               @id @default(cuid())
  reportId        String
  report          BudgetReport         @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromLineId      String
  fromLine        BudgetLine           @relation("ReallocationFrom", fields: [fromLineId], references: [id], onDelete: Cascade)
  toLineId        String?
  toLine          BudgetLine?          @relation("ReallocationTo", fields: [toLineId], references: [id], onDelete: SetNull)
  toDescription   String?
  toSection       BudgetSection?
  requestedAmount Float
  isRecurring     Boolean              @default(false)
  monthlyAmount   Float                @default(0)
  durationType    ReallocationDuration
  durationMonths  Int?
  // null = the money moves within the reporting slot's own grant year. A later
  // year means the partner is asking for this year's unspent amount to carry
  // forward: nothing carries unless it is asked for and approved here.
  targetGrantYear Int?
  rationale       String
  sourceUnspent   Float                @default(0)
  willSustain     Boolean              @default(true)
  sustainNote     String?
  status          ReallocationStatus   @default(pending)
  approvedAmount  Float?
  reviewerComment String?
  resolvedAt      DateTime?
  createdLineId   String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([reportId])
  @@index([fromLineId])
}

/// A reviewer's query about one line of a report, and the partner's replies to
/// it. Sending a whole report back says nothing about what was wrong; these say
/// exactly which line to look at.
/// Line-level conversation on a draft budget during the grant-making stage:
/// the lead queries a line, the partner answers. Distinct from
/// BudgetReportLineNote, which hangs off a filed report, not the budget.
model BudgetLineNote {
  id           String      @id @default(cuid())
  budgetId     String
  budget       Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  // Nullable with SetNull, unlike BudgetReportLineNote: a partner deleting the
  // line being objected to must not erase the objection. A null line is a
  // whole-budget note (e.g. the reason a draft was sent back).
  budgetLineId String?
  budgetLine   BudgetLine? @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  // Budget.partnerRound at the time of writing, so iterations don't merge into
  // one undifferentiated thread.
  round        Int         @default(0)
  body         String
  authorId     String
  author       User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime    @default(now())

  @@index([budgetId, round])
  @@index([budgetLineId])
}

model BudgetReportLineNote {
  id           String       @id @default(cuid())
  reportId     String
  report       BudgetReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  budgetLineId String
  budgetLine   BudgetLine   @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  body         String
  authorId     String
  author       User         @relation(fields: [authorId], references: [id], onDelete: Cascade)
  resolvedAt   DateTime?
  resolvedById String?
  createdAt    DateTime     @default(now())

  @@index([reportId])
  @@index([budgetLineId])
}

model BudgetReportLine {
  id           String       @id @default(cuid())
  reportId     String
  report       BudgetReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  budgetLineId String
  budgetLine   BudgetLine   @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  actualAmount Float        @default(0)
  notes        String?

  @@unique([reportId, budgetLineId])
  @@index([reportId])
}

model CostRegistry {
  id            String   @id @default(cuid())
  city          String   @default("Bangalore")
  domain        String?
  itemKey       String
  unitCost      Float
  unit          String
  effectiveYear Int      @default(2025)
  notes         String?
  // Free-text "how this rate was arrived at" for items that don't decompose
  // into components (e.g. "avg of 3 vendor quotes"). Complements the structured
  // CostRegistryComponent breakup.
  derivation    String?
  displayGroup  String? // for inp.* items: "geography" | "facilities" | "coverage"; null → coverage
  needsDomain   String? // for inp.* items: links to NeedsFormulaConfig.domain for scenario loading
  updatedAt     DateTime @updatedAt

  @@unique([city, itemKey])
}

// Append-only change log for CostRegistry unit costs. Written on every registry
// mutation (seed, admin edit, reset, reseed). Reproduction of old budgets is
// already handled by Budget.costSnapshot; this table exists for the reflective
// "what changed, when, why" trail across cost revisions. Generic across domains.
//   oldCost null  → item created
//   newCost null  → item deleted
model CostRegistryHistory {
  id          String   @id @default(cuid())
  city        String
  domain      String?
  itemKey     String
  oldCost     Float?
  newCost     Float?
  source      String? // "Urban Creche V.2 May25" | "admin edit" | "seed" | "reset"
  reason      String?
  changedById String?
  changedAt   DateTime @default(now())

  @@index([city, itemKey, changedAt])
}

// A named, frozen copy of one scope's registry — "FY27 rates" — so a unit can
// publish a whole rate revision at once and roll the whole thing back.
//
// CostRegistryHistory already records every individual change, but a rate cycle
// touches hundreds of keys and unwinding it row by row is not something anyone
// will actually do. This is the atomic unit.
//
// Restoring never disturbs an existing budget: a budget freezes its own
// costSnapshot and line components at generation, so a version only ever
// governs what gets generated next.
model CostRegistryVersion {
  id            String   @id @default(cuid())
  city          String // the scope this belongs to; "Global" for the shared layer
  label         String // "FY27 rates"
  notes         String?
  effectiveFrom DateTime // when these rates are meant to apply from
  publishedAt   DateTime @default(now())
  publishedById String?
  /// { items: [...CostRegistry fields], components: { parentItemKey: [...] } }
  snapshot      Json

  @@index([city, publishedAt])
}

// Structured breakup of an aggregate CostRegistry item (e.g. an asset bundle
// that sums many sub-items). Optional & additive: items with no components keep
// their flat hand-entered unitCost. Where components exist, the parent's
// unitCost is the roll-up Σ(qty × unitCost) and the Working sheet expands these
// rows so the derivation stays visible. Generic across all domains.
model CostRegistryComponent {
  id            String   @id @default(cuid())
  city          String
  parentItemKey String // FK-by-convention to CostRegistry.itemKey (same city)
  position      Int      @default(0)
  label         String
  spec          String? // free-text specification from the cost book
  qty           Float    @default(1)
  unitCost      Float // amount = qty × unitCost
  notes         String?
  updatedAt     DateTime @updatedAt

  @@index([city, parentItemKey, position])
}

// Each row is one generated line in a budget.
// The formula fields fully describe how to compute unitCount and unitCost
// from programme inputs (nCLCs, nCreches, etc.) and the cost registry.
//
// Unit count:
//   inputVar     – which programme input scales this line
//                  "fixed_1"|"fixed_12"|"nCLCs"|"nYRCs"|"nSettlements"|
//                  "nClusters"|"nElderly"|"nElderlyCentres"|"nCreches"|"cosTotal"
//   inputMonthly – multiply by 12 (monthly → annual)
//   supervisorRatioKey – if set: units = ceil(inp[inputVar] / reg[key]) × 12
//
// Unit cost (evaluated in order – first matching rule wins):
//   isSalaryStub   – cost = 0 (user fills salary)
//   userInputCost  – cost = programme input field (rent entered by user)
//   costPctOf      – cost = reg[costPctOf] × costPct / 100
//   workerRatioKey – cost = reg[wKey] × reg[costKey] × 12 × (1 + reg[bufferKey]/100)
//   costKey[2][3]  – cost = reg[k1] × reg[k2?] × reg[k3?] × (12 if costMonthly)
//
// y1UnitsZero: override Y1 units to 0 (e.g. CAPEX maintenance starts Y2)
model LineTemplate {
  id              String        @id @default(cuid())
  city            String
  domain          String?
  section         BudgetSection
  description     String
  costCategory    InflationType
  unitType        String        @default("")
  position        Int
  isActive        Boolean       @default(true)
  isAutoGenerated Boolean       @default(true)
  notes           String?
  salaryHint      String?
  templateKey     String // stable slug used for upsert seeding

  // unit count
  inputVar           String  @default("fixed_1")
  inputMonthly       Boolean @default(false)
  supervisorRatioKey String?
  inputThreshold     Int? // if set: suppress line (units=0) when inputVar value <= this

  // unit cost
  isSalaryStub   Boolean @default(false)
  userInputCost  String?
  costKey        String?
  costKey2       String?
  costKey3       String?
  costMonthly    Boolean @default(false)
  workerRatioKey String?
  bufferKey      String?
  costPctOf      String?
  costPct        Float?
  y1UnitsZero    Boolean @default(false)

  // Parametric unit cost. When set, evaluated against {inp.*, cost-registry keys}
  // via lib/formula/engine — costKey / costPctOf / workerRatioKey are ignored on
  // this line and units default to 1 (all scaling happens inside the formula).
  formula         String?
  formulaUnitType String?

  // Year applicability & expansion / reduction
  applyY1      Boolean @default(true)
  applyY2      Boolean @default(true)
  applyY3      Boolean @default(true)
  y2UnitsScale Float? // null = same as Y1; 1.5 = 50% more; 0.5 = 50% fewer
  y3UnitsScale Float?

  @@unique([city, templateKey])
  @@index([city, domain, position])
}

// ── Layer 3: Programme Journeys ──────────────────────────────────────────────
// Threads connecting multiple goals (across templates / over time) under a
// shared outcome objective. Auto-spawned per (domain, settlement) on goal
// apply. Phases form a DAG (linear by default; admin can rewire).

model ProgrammeJourney {
  id              String    @id @default(cuid())
  // Stable slug for ops + dedupe, e.g. "creche-munireddypalya"
  key             String    @unique
  label           String
  // Auto-linking dimension. Null when admin makes a cross-domain super-journey.
  primaryDomain   String?
  settlementId    String
  status          String    @default("Active") // Active | Paused | Closed
  notes           String?
  // Closure metadata
  closedAt        DateTime?
  closedReason    String?
  closedById      String?
  // Snapshot of final outcome values at closure time (JSON: { outcomeKey: value })
  outcomeSnapshot Json?
  // Optional pointer to a parent super-journey (cross-domain aggregation).
  parentId        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  settlement Settlement                @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  parent     ProgrammeJourney?         @relation("ProgrammeJourneyChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children   ProgrammeJourney[]        @relation("ProgrammeJourneyChildren")
  phases     ProgrammeJourneyPhase[]
  outcomes   ProgrammeJourneyOutcome[]
  closedBy   User?                     @relation("JourneyClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  @@index([settlementId, primaryDomain])
  @@index([parentId])
}

model ProgrammeJourneyPhase {
  id        String   @id @default(cuid())
  journeyId String
  // Layout hint only — real ordering is the DAG (edges)
  position  Int      @default(0)
  label     String // "Setup" | "Operations" | "Maintenance" | custom
  // Canvas coordinates for the DAG view. Null = auto-layout.
  canvasX   Int?
  canvasY   Int?
  // The fulfilling goal. Null = logical/planned phase not yet started.
  goalId    String?
  status    String   @default("Planned") // Planned | Active | Done | Skipped
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journey  ProgrammeJourney            @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  goal     Goal?                       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  outEdges ProgrammeJourneyPhaseEdge[] @relation("PhaseOutEdges")
  inEdges  ProgrammeJourneyPhaseEdge[] @relation("PhaseInEdges")

  @@index([journeyId])
  @@index([goalId])
}

model ProgrammeJourneyPhaseEdge {
  id          String  @id @default(cuid())
  fromPhaseId String
  toPhaseId   String
  label       String? // "after creche running", "in parallel"

  from ProgrammeJourneyPhase @relation("PhaseOutEdges", fields: [fromPhaseId], references: [id], onDelete: Cascade)
  to   ProgrammeJourneyPhase @relation("PhaseInEdges", fields: [toPhaseId], references: [id], onDelete: Cascade)

  @@unique([fromPhaseId, toPhaseId])
}

model ProgrammeJourneyOutcome {
  id                      String   @id @default(cuid())
  journeyId               String
  key                     String // unique within journey
  label                   String
  description             String?
  unit                    String?
  // MANUAL_ADMIN | RP_ACTIVITY (mirrors FacilityIndicatorSource)
  captureSource           String   @default("MANUAL_ADMIN")
  // For RP_ACTIVITY: bind to a checklist key (one binding per outcome in v1) — legacy string join
  bindingTemplateSlug     String?
  bindingChecklistKey     String?
  // P1b: FK-clean anchor (either a template checklist item or a catalog-native item)
  bindingChecklistDefId   String?
  bindingCatalogItemDefId String?
  targetValue             Float?
  targetCadence           String? // "annual" | "quarterly" | "monthly"
  sortOrder               Int      @default(0)
  isActive                Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  journey               ProgrammeJourney               @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  points                ProgrammeJourneyOutcomePoint[]
  bindingChecklistDef   TemplateChecklistDef?          @relation(fields: [bindingChecklistDefId], references: [id], onDelete: SetNull)
  bindingCatalogItemDef CatalogItemDef?                @relation(fields: [bindingCatalogItemDefId], references: [id], onDelete: SetNull)

  @@unique([journeyId, key])
  @@index([bindingChecklistDefId])
  @@index([bindingCatalogItemDefId])
}

model ProgrammeJourneyOutcomePoint {
  id           String   @id @default(cuid())
  outcomeId    String
  value        Float
  capturedAt   DateTime
  source       String // MANUAL_ADMIN | RP_ACTIVITY
  capturedById String?
  sourceRefId  String? // ChecklistItem.id for RP_ACTIVITY
  note         String?
  createdAt    DateTime @default(now())

  outcome    ProgrammeJourneyOutcome @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  capturedBy User?                   @relation("JourneyOutcomeCapture", fields: [capturedById], references: [id], onDelete: SetNull)

  @@index([outcomeId, capturedAt])
}

// Outcome templates — admin-defined packs that can be applied to any journey
// matching a target domain. Each pack contains one or more outcome definitions
// (label / unit / target / capture mode) that get cloned into a journey on apply.
model ProgrammeJourneyOutcomeTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  label     String
  // Optional domain filter — admin can apply this pack only to journeys whose
  // primaryDomain matches (or to any journey if null).
  domain    String?
  notes     String?
  // JSON array of outcome definitions to clone into the journey on apply.
  // Shape: [{ key, label, unit, captureSource, bindingTemplateSlug?, bindingChecklistKey?, targetValue?, targetCadence? }]
  outcomes  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── RBAC ──────────────────────────────────────────────────────────────────────
// Centralized role/permission system. User.role (string) is the canonical role
// identifier; it matches Role.name 1:1. Keeping the string column avoids a
// breaking schema change for now — a future migration can swap to an FK.

model Role {
  id          String   @id @default(cuid())
  name        String   @unique // "super-admin" | "admin" | "member" | "viewer" | "budget-admin"
  description String?
  isSystem    Boolean  @default(true) // System roles cannot be deleted from admin UI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  authorityRules AuthorityRule[]
}

model Permission {
  id        String   @id @default(cuid())
  resource  String // "goal" | "pitstop" | "user" | "thread" | ...
  action    String // "list" | "read" | "create" | "update" | "delete" | special verbs
  createdAt DateTime @default(now())

  roles RolePermission[]

  @@unique([resource, action])
}

// Pivot with the *scope rule* attached. The rule is jsonb so the admin UI can
// edit predicates without a schema migration. See lib/rbac.ts for evaluators.
model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  scopeRule    Json // { kind: "all" | "self" | "own" | "team" | "city" | ... }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
}

// ── Org ──────────────────────────────────────────────────────────────────────
// Tenancy / partner identification. Internal staff share the "Pitstops
// Internal" org seeded via prisma/seed-wiki.ts. Partner NGO orgs are added
// later when partner-user onboarding ships.
model Org {
  id           String    @id @default(cuid())
  name         String
  slug         String    @unique
  kind         String // "internal" | "partner"
  // Partner-identity columns. Lifted from the old MapPartner model so every
  // partner-shaped reference (Settlement, Cluster, LayerFeature, Wiki, User)
  // can point at the same row. mapKey is the legacy LAYERS slug used to
  // colorise polygons — nullable for internal orgs and any partner that
  // doesn't have its own map layer. archivedAt is the soft-delete signal;
  // partner FKs use SetNull so historical references survive removal.
  color        String?   @default("#6366f1")
  mapKey       String?   @unique
  contactName  String?
  contactPhone String?
  contactEmail String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  users                 User[]
  partnerReviewMeetings WikiPartnerReviewMeeting[] @relation("WikiPartnerReviewMeetingOrg")
  wikiPracticeGaps      WikiPracticeGap[]          @relation("WikiPracticeGapPartnerOrg")
  wikiObservations      WikiPracticeObservation[]  @relation("WikiPracticeObservationPartnerOrg")
  wikiPracticeEntries   WikiPracticeEntry[]        @relation("WikiPracticeEntryPartnerOrg")
  // Partner-org geo bindings (added 2026-06-04, replaces MapPartner relations
  // and LayerFeature.partner free-text). See migration M2.
  settlementsAsPartner  Settlement[]               @relation("SettlementPartnerOrg")
  clustersAsPartner     Cluster[]                  @relation("ClusterPartnerOrg")
  facilitiesAsPartner   LayerFeature[]             @relation("LayerFeaturePartnerOrg")
  // Optional link from a Seeding outreach channel that is already an APF partner.
  seedingChannels       SeedingChannel[]           @relation("SeedingChannelOrg")
  // Cross-portal partner registry (2026-11-03). Org is the single partner
  // identity; these are the per-portal attachments that used to be separate
  // identities of their own. See lib/partners/registry.ts.
  grantRelationships    GrantPartner[]             @relation("GrantPartnerOrg")
  partnerLogins         GrantPartnerUser[]         @relation("PartnerLoginOrg")
  aliases               OrgAlias[]
  // Grant-ERP: statutory registrations with validity windows, declared
  // conflicts, and inbound proposals.
  compliance            OrgCompliance[]
  conflictDeclarations  ConflictDeclaration[]
  proposals             Proposal[]
  financialYears        OrgFinancialYear[]
}

/// Name variants that resolve to one Org.
///
/// Needed because two portals minted partners as free text before the registry
/// existed: the review portal's 33 grant notes hold seven spellings of one
/// grantee ("Gubbachi", "Gubbachi Foundation", "Gubbachi NGO", "Gubabchi", …)
/// and "SEIDS" for SIEDS. A lookup table, not a fuzzy match: "Gubbachi NGO" and
/// "Gubbachi Foundation" are one org by someone's judgement, not by edit
/// distance, and a typo must stay resolved once a human has resolved it.
///
/// `normalized` is the match key — lowercased, non-alphanumerics stripped (see
/// normalizePartnerName). Unique globally, so one spelling can never resolve to
/// two orgs.
model OrgAlias {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  /// The spelling as it was found in the wild, kept for the audit trail.
  alias      String
  normalized String   @unique
  /// Where this spelling came from, e.g. "grant_notes.org_name".
  source     String?
  createdAt  DateTime @default(now())

  @@index([orgId])
}

// ── Wiki module ──────────────────────────────────────────────────────────────
// Owner-driven knowledge/practice pages. Per-page owner sits on WikiPage.ownerId;
// global steward/curator powers live in WikiStaff (decoupled from User.role).
// Tag values are free strings under tagType taxonomies. Translations live in
// translatedContent as { lang: { content, translatedAt } }.

model WikiPage {
  id                String    @id @default(cuid())
  slug              String    @unique
  title             String
  type              String // "principle" | "playbook" | "runbook" | "manual"
  // Manual subtype: ground-truth density signal. NULL for non-manual pages.
  // "mostly_theory" | "emerging" | "seasoned". Orthogonal to status — status
  // tracks editorial state; maturity tracks how field-tested the content is.
  maturity          String?
  // Restricted-handling flag (e.g. mental health, GBV modules). When true the
  // reader shows a sensitive banner; field-level RBAC gating is layered later.
  isSensitive       Boolean   @default(false)
  sensitiveNote     String? // restricted-handling instruction shown on the reader
  canonicalLang     String    @default("en") // en | ta | kn | ml | hi | bn
  canonicalContent  String    @default("") // markdown serialised from Tiptap (unused for manual subtype — see WikiManualSection)
  translatedContent Json      @default("{}") // { ta: { content, translatedAt }, ... }
  ownerId           String?
  ownerTermStart    DateTime?
  ownerTermEnd      DateTime?
  nextReviewDue     DateTime?
  lastReviewedAt    DateTime?
  lastEditedAt      DateTime  @default(now())
  lastEditedById    String?
  status            String    @default("draft") // draft | published | under_review | orphaned | retired
  createdAt         DateTime  @default(now())
  archivedAt        DateTime?
  archivedById      String?

  owner                 User?                      @relation("WikiPageOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lastEditor            User?                      @relation("WikiPageLastEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  tags                  WikiPageTag[]
  versions              WikiPageVersion[]
  comments              WikiComment[]
  flags                 WikiFlag[]
  reviews               WikiReviewCycle[]
  notifLogs             WikiNotificationLog[]
  practiceCircles       WikiPracticeCircle[]       @relation("WikiPracticeCirclePages")
  partnerReviewMeetings WikiPartnerReviewMeeting[] @relation("WikiPartnerReviewMeetingPages")
  handovers             WikiOwnerHandover[]
  translationFlags      WikiTranslationFlag[]
  views                 WikiPageView[]
  practiceGaps          WikiPracticeGap[]          @relation("WikiPracticeGapLinkedPage")
  observations          WikiPracticeObservation[]  @relation("WikiPracticeObservationPrimaryPage")
  // Manual subtype
  manualSections        WikiManualSection[]
  practiceEntries       WikiPracticeEntry[]
  boundariesFrom        WikiManualBoundary[]       @relation("WikiManualBoundaryFrom")
  boundariesTo          WikiManualBoundary[]       @relation("WikiManualBoundaryTo")

  @@index([status])
  @@index([type])
  @@index([type, maturity])
  @@index([nextReviewDue])
  @@index([ownerId])
  @@index([ownerTermEnd])
}

model WikiPageTag {
  id       String @id @default(cuid())
  pageId   String
  tagType  String // "vertical" | "city" | "partner_org" | "activity_type"
  tagValue String

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, tagType, tagValue])
  @@index([tagType, tagValue])
}

model WikiPageVersion {
  id              String   @id @default(cuid())
  pageId          String
  versionNumber   Int
  contentSnapshot String // full markdown at this version
  language        String // which language was edited
  editedById      String
  editedAt        DateTime @default(now())
  changeNote      String?

  page   WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  editor User     @relation("WikiPageVersionEditor", fields: [editedById], references: [id])

  @@unique([pageId, versionNumber])
  @@index([editedById])
}

model WikiComment {
  id            String    @id @default(cuid())
  pageId        String
  authorId      String
  sectionAnchor String?
  body          String
  language      String
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?
  resolvedById  String?

  page       WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author     User     @relation("WikiCommentAuthor", fields: [authorId], references: [id])
  resolvedBy User?    @relation("WikiCommentResolver", fields: [resolvedById], references: [id])

  @@index([pageId])
  @@index([authorId])
}

model WikiFlag {
  id            String    @id @default(cuid())
  pageId        String
  flaggerId     String
  sectionAnchor String?
  reason        String
  status        String    @default("open") // open | acknowledged | resolved
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  page    WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  flagger User     @relation("WikiFlagFlagger", fields: [flaggerId], references: [id])

  @@index([pageId, status])
  @@index([flaggerId])
}

model WikiReviewCycle {
  id                            String    @id @default(cuid())
  pageId                        String
  ownerId                       String
  scheduledFor                  DateTime
  completedAt                   DateTime?
  completionNote                String?
  type                          String // quarterly | post_circle | post_partner_review
  // Legacy free-string trigger from PR1 — superseded by the FK columns below,
  // kept nullable for safety. New code should write to triggerCircleId or
  // triggerPartnerReviewMeetingId instead.
  triggerSourceId               String?
  triggerCircleId               String?
  triggerPartnerReviewMeetingId String?
  createdAt                     DateTime  @default(now())

  page                        WikiPage                  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  owner                       User                      @relation("WikiReviewCycleOwner", fields: [ownerId], references: [id])
  triggerCircle               WikiPracticeCircle?       @relation(fields: [triggerCircleId], references: [id], onDelete: SetNull)
  triggerPartnerReviewMeeting WikiPartnerReviewMeeting? @relation(fields: [triggerPartnerReviewMeetingId], references: [id], onDelete: SetNull)

  @@unique([pageId, triggerCircleId])
  @@unique([pageId, triggerPartnerReviewMeetingId])
  @@index([pageId])
  @@index([ownerId, completedAt])
}

model WikiStaff {
  id        String   @id @default(cuid())
  userId    String
  wikiRole  String // "curator" | "steward"
  scope     Json? // { cities: [...], verticals: [...] } — null = global
  createdAt DateTime @default(now())

  user User @relation("WikiStaffUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wikiRole])
  @@index([wikiRole])
}

// Notification dispatch audit log. Captures every intended wiki-related
// notification (push / inApp / whatsapp) with status so we can debug why a
// digest didn't fire, and so the WhatsApp adapter — currently a stub — leaves
// a paper trail of "would have sent" intent until the provider is chosen.
model WikiNotificationLog {
  id        String   @id @default(cuid())
  userId    String
  pageId    String?
  kind      String // "wiki_flag_created" | "wiki_comment_created" | "wiki_weekly_digest" | ...
  channel   String // "push" | "inApp" | "whatsapp"
  status    String // "sent" | "skipped" | "failed" | "intended_no_adapter"
  payload   Json
  error     String?
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  page WikiPage? @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([pageId])
  @@index([kind, createdAt])
}

// Practice circle: scheduled internal meeting (vertical + zone scoped) where
// staff discuss a case. Pages linked here get a "review within 7 days" prompt
// to their owners once the circle is marked completed.
model WikiPracticeCircle {
  id            String    @id @default(cuid())
  scheduledFor  DateTime
  completedAt   DateTime?
  vertical      String?
  zoneId        String?
  facilitatorId String
  caseDiscussed String?
  notes         String?
  recordingUrl  String?
  language      String    @default("en")
  // Soft-delete. Lists, dashboards, crons all filter archivedAt: null.
  archivedAt    DateTime?
  archivedById  String?
  createdAt     DateTime  @default(now())

  zone            Zone?               @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  facilitator     User                @relation("WikiPracticeCircleFacilitator", fields: [facilitatorId], references: [id])
  attendees       User[]              @relation("WikiPracticeCircleAttendees")
  linkedPages     WikiPage[]          @relation("WikiPracticeCirclePages")
  reviewCycles    WikiReviewCycle[]
  practiceEntries WikiPracticeEntry[] @relation("WikiPracticeEntryCircle")

  @@index([scheduledFor])
  @@index([facilitatorId])
  @@index([zoneId])
  @@index([archivedAt])
}

// Partner review meeting: scheduled session with a partner NGO where the team
// notes any changes to shared practice. Linked pages get the same post-event
// review prompt as practice circles.
model WikiPartnerReviewMeeting {
  id                   String    @id @default(cuid())
  partnerOrgId         String
  scheduledFor         DateTime
  completedAt          DateTime?
  practiceChangesNoted String?
  notes                String?
  language             String    @default("en")
  // Soft-delete. Lists, dashboards, crons all filter archivedAt: null.
  archivedAt           DateTime?
  archivedById         String?
  createdAt            DateTime  @default(now())

  partnerOrg   Org               @relation("WikiPartnerReviewMeetingOrg", fields: [partnerOrgId], references: [id])
  attendees    User[]            @relation("WikiPartnerReviewMeetingAttendees")
  linkedPages  WikiPage[]        @relation("WikiPartnerReviewMeetingPages")
  reviewCycles WikiReviewCycle[]

  @@index([scheduledFor])
  @@index([partnerOrgId])
  @@index([archivedAt])
}

// Pending or completed owner handover. The owner initiates by inserting a
// pending row addressed to the proposed new owner; the proposed owner then
// accepts (which flips WikiPage.ownerId + resets the term) or declines.
model WikiOwnerHandover {
  id           String    @id @default(cuid())
  pageId       String
  fromUserId   String
  toUserId     String
  handoverNote String?
  status       String    @default("pending") // pending | accepted | declined
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  page     WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  fromUser User     @relation("WikiHandoverFrom", fields: [fromUserId], references: [id])
  toUser   User     @relation("WikiHandoverTo", fields: [toUserId], references: [id])

  @@index([pageId, status])
  @@index([toUserId, status])
}

// Reader-flagged translation quality issue. Goes to a queue for human review.
// Per-language so the same page can have flags against different translations
// simultaneously.
model WikiTranslationFlag {
  id         String    @id @default(cuid())
  pageId     String
  language   String // target language code: ta | kn | ml | hi | bn | en
  flaggerId  String
  reason     String
  status     String    @default("open") // open | resolved
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  page    WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  flagger User     @relation(fields: [flaggerId], references: [id])

  @@index([status])
  @@index([pageId, language])
}

// Per-user, per-page view record — written at most once per (user, page, day)
// from the reader server page. Visible only to stewards and curators per spec
// ("Do not show view counts or popularity to owners or readers — avoids vanity
// dynamics distorting content").
model WikiPageView {
  id        String   @id @default(cuid())
  pageId    String
  userId    String
  createdAt DateTime @default(now())

  page WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([pageId, createdAt])
  @@index([userId, createdAt])
}

// Practice gap queue: "there is no page for the thing I am doing today."
// Distinct from WikiFlag (which targets an existing page). A gap has no
// pageId at file time. The curator's weekly walk routes it to an owner who
// drafts a page; the gap closes when the page publishes, with linkedPageId
// pointing back at it. See public/training/modules/practice-documentation/
// 05-practice-gap-queue.html for the protocol.
model WikiPracticeGap {
  id               String    @id @default(cuid())
  vertical         String // e.g. "food", "creche", "welfare-rights"
  oneLineNeed      String // the gap, in one sentence
  suggestedTitle   String? // optional — owner may rename
  city             String? // bangalore | chennai | null (universal)
  partnerOrgId     String? // optional partner scope
  filerId          String
  status           String    @default("open") // open | assigned | drafted | merged | published | declined
  assignedOwnerId  String?
  curatorTriagerId String?
  triagedAt        DateTime?
  draftingDeadline DateTime?
  // When status flips to merged/published, points at the page that absorbed
  // or fulfilled the gap. Allows the filer-loop notification + cross-link.
  linkedPageId     String?
  declineReason    String?
  // Soft-delete (distinct from resolvedAt, which is a triage outcome).
  archivedAt       DateTime?
  archivedById     String?
  createdAt        DateTime  @default(now())
  resolvedAt       DateTime?

  filer          User      @relation("WikiPracticeGapFiler", fields: [filerId], references: [id])
  assignedOwner  User?     @relation("WikiPracticeGapAssignee", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  curatorTriager User?     @relation("WikiPracticeGapTriager", fields: [curatorTriagerId], references: [id], onDelete: SetNull)
  partnerOrg     Org?      @relation("WikiPracticeGapPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)
  linkedPage     WikiPage? @relation("WikiPracticeGapLinkedPage", fields: [linkedPageId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([vertical, status])
  @@index([assignedOwnerId, status])
  @@index([filerId])
  @@index([createdAt])
  @@index([archivedAt])
}

// Field shadow visits and new-CO onboarding sessions. Shared model with a
// `kind` discriminator — both observations capture the same shape: an observer
// (owner / RP), an observed person (CO), a partner / vertical / city, notes,
// optional drift flag, optional primary page touched. See module 6 of the
// practice-documentation training.
model WikiPracticeObservation {
  id             String    @id @default(cuid())
  kind           String // "shadow" | "onboarding"
  observerId     String
  observedUserId String?
  partnerOrgId   String?
  vertical       String
  city           String?
  happenedAt     DateTime
  notes          String    @default("")
  openQuestions  String?
  // True when the observation revealed drift between page and practice — the
  // observer also files a flag against the page. Useful for the dashboard.
  driftFlagged   Boolean   @default(false)
  // Single page this observation primarily touched. Nullable: onboarding may
  // span many pages, shadow visits may touch none yet (gap incoming).
  primaryPageId  String?
  // Soft-delete. Lists, dashboards, crons all filter archivedAt: null.
  archivedAt     DateTime?
  archivedById   String?
  createdAt      DateTime  @default(now())

  observer    User      @relation("WikiPracticeObservationObserver", fields: [observerId], references: [id], onDelete: Restrict)
  observed    User?     @relation("WikiPracticeObservationObserved", fields: [observedUserId], references: [id], onDelete: SetNull)
  partnerOrg  Org?      @relation("WikiPracticeObservationPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)
  primaryPage WikiPage? @relation("WikiPracticeObservationPrimaryPage", fields: [primaryPageId], references: [id], onDelete: SetNull)

  @@index([kind, happenedAt])
  @@index([observerId, happenedAt])
  @@index([partnerOrgId, kind])
  @@index([vertical, happenedAt])
  @@index([archivedAt])
}

// ─── Response Manual (wiki manual subtype) ───────────────────────────────────
// A manual is a WikiPage with type="manual". Its content is sectioned (8 fixed
// sections, see lib/wiki/manual.ts) rather than the free-form Tiptap blob in
// WikiPage.canonicalContent. Spine sections (S2/S3/S7) are owner-edited; living
// sections (S4/S6/S8) grow primarily through WikiPracticeEntry append-only
// captures fed by practice circles, partner reviews, and shadow visits.

// One row per (manual, sectionNumber). Section content is markdown, matching
// WikiPage.canonicalContent conventions so the same renderer applies.
model WikiManualSection {
  id             String   @id @default(cuid())
  pageId         String
  sectionNumber  Int // 1..8, see lib/wiki/manual.ts SECTION_LABELS
  content        String   @default("") // markdown (canonical lang of the parent page)
  lastEditedAt   DateTime @default(now())
  lastEditedById String?

  page       WikiPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  lastEditor User?    @relation("WikiManualSectionEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)

  @@unique([pageId, sectionNumber])
  @@index([pageId])
}

// Append-only practice-circle feed targeting a specific manual section.
// Default destination is section 6 ("where it gets stuck") — most circle output
// is failures/workarounds. Editors promote recurring entries to a standard
// branch in section 5 by stamping promotedToSectionNumber + promotedById.
model WikiPracticeEntry {
  id                      String    @id @default(cuid())
  pageId                  String // the manual
  sectionNumber           Int // which slot, 1..8
  body                    String
  observerId              String // CO / RP / facilitator who captured this
  settlement              String? // free-text location (e.g. "Semmancherry")
  partnerOrgId            String?
  happenedAt              DateTime
  status                  String    @default("raw") // raw | reviewed | promoted
  promotedToSectionNumber Int? // typically 5, when promoted from S6 anecdote
  promotedById            String?
  promotedAt              DateTime?
  // Optional source — when the entry was captured inside a circle session.
  circleId                String?
  // Soft-delete (entries are otherwise immutable for shelf-life integrity).
  archivedAt              DateTime?
  archivedById            String?
  createdAt               DateTime  @default(now())

  page       WikiPage            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  observer   User                @relation("WikiPracticeEntryObserver", fields: [observerId], references: [id], onDelete: Restrict)
  partnerOrg Org?                @relation("WikiPracticeEntryPartnerOrg", fields: [partnerOrgId], references: [id], onDelete: SetNull)
  promoter   User?               @relation("WikiPracticeEntryPromoter", fields: [promotedById], references: [id], onDelete: SetNull)
  circle     WikiPracticeCircle? @relation("WikiPracticeEntryCircle", fields: [circleId], references: [id], onDelete: SetNull)

  @@index([pageId, sectionNumber])
  @@index([pageId, status])
  @@index([observerId, happenedAt])
  @@index([status, createdAt])
  @@index([circleId])
  @@index([archivedAt])
}

// Typed module-to-module edge. "hands_off" = a hard handoff the CO must take
// (e.g. Mental Health → Safety Pathway on self-harm risk). "draws_on" = shared
// content / cross-reference. Both endpoints must be WikiPage rows with
// type="manual"; not enforced at the DB level (cheap to check in the app).
model WikiManualBoundary {
  id         String   @id @default(cuid())
  fromPageId String
  toPageId   String
  kind       String // "hands_off" | "draws_on"
  note       String? // e.g. "trigger: any expression of self-harm risk"
  createdAt  DateTime @default(now())

  fromPage WikiPage @relation("WikiManualBoundaryFrom", fields: [fromPageId], references: [id], onDelete: Cascade)
  toPage   WikiPage @relation("WikiManualBoundaryTo", fields: [toPageId], references: [id], onDelete: Cascade)

  @@unique([fromPageId, toPageId, kind])
  @@index([fromPageId])
  @@index([toPageId])
}

// ─── Operating Models (parametric unit-economics engine) ─────────────────────
// Templates are *data*, not code. Same pattern as GoalTemplateDef.
// See memory/operating_models.md for the full design.

model ModelTemplate {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. "ro_water"
  name        String
  description String   @default("")
  // Time bases this template uses, e.g. [{key:"monthly",length:60},{key:"annual",length:5}].
  // Author-defined; nodes bind to one of these keys (or "scalar").
  horizons    Json     @default("[]")
  // Optional ordering hint for /models lists
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  groups    ModelGroup[]
  nodes     ModelNode[]
  outputs   ModelOutput[]
  instances ModelInstance[]
}

// UI grouping for inputs in the play surface (e.g. "Site & Population", "Pricing").
model ModelGroup {
  id         String        @id @default(cuid())
  templateId String
  template   ModelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String // unique within a template
  label      String
  order      Int           @default(0)
  // Which play surface this group's inputs belong to: "finance" | "sim" | "both".
  // Drives tab-filtering in the play workbench. Nodes inherit unless they override.
  surface    String        @default("both")
  createdAt  DateTime      @default(now())

  nodes ModelNode[]

  @@unique([templateId, key])
  @@index([templateId, order])
}

// A node in the model graph: input cell, formula cell, constant, or table.
// shape encodes whether it's a scalar or vector tied to a template horizon.
// shape examples: {kind:"scalar"} | {kind:"vector", horizon:"monthly"}
model ModelNode {
  id          String        @id @default(cuid())
  templateId  String
  template    ModelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  groupId     String?
  group       ModelGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  key         String // unique within a template; referenced by formulas
  label       String
  notes       String?
  unit        String? // free text: "INR/litre", "%", "kWh/1000L"
  kind        String // "input" | "formula" | "constant"
  dataType    String // "number" | "percent" | "currency" | "int" | "boolean" | "enum"
  shape       Json          @default("{\"kind\":\"scalar\"}")
  // Default value for input/constant nodes. For vectors, may be a single number
  // (broadcast) or an array. Formulas ignore this.
  defaultJson Json?
  // For formula nodes: the expression source. Null for inputs/constants.
  formula     String?
  // For enum dataType: array of allowed values.
  enumValues  Json?
  // Play-surface this node belongs to: "finance" | "sim" | "both". Overrides the
  // group's surface when not "both". Finance-only nodes vanish on the sim tab and
  // vice-versa; "both" nodes (e.g. plant capacity, price, tank size) show on both.
  surface     String        @default("both")
  // Detail tier for the sim tab's Basic/Advanced toggle: "basic" | "advanced".
  // Advanced nodes (engineering constants) stay hidden until the toggle flips.
  // Ignored on the finance/editor tabs, which always show every tier.
  tier        String        @default("basic")
  // Optional slider config for the sim tab: { min, max, step }. Present → render
  // a slider+readout; absent → typed number input.
  uiJson      Json?
  order       Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([templateId, key])
  @@index([templateId, order])
  @@index([groupId])
}

// Author-defined outputs to render: KPI cards, time-series, sensitivity grids,
// scenario comparisons, budget exports. kind drives the renderer; config is
// renderer-specific.
model ModelOutput {
  id         String        @id @default(cuid())
  templateId String
  template   ModelTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  key        String
  label      String
  // "kpi" | "series" | "table" | "sensitivity" | "scenarioGrid" | "budgetExport"
  kind       String
  config     Json          @default("{}")
  order      Int           @default(0)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([templateId, key])
  @@index([templateId, order])
}

// A saved set of input overrides for a template. Nullable pitstopId supports
// standalone-first then attach-later. parentInstanceId links scenario siblings.
model ModelInstance {
  id               String          @id @default(cuid())
  templateId       String
  template         ModelTemplate   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name             String
  pitstopId        String?
  // For scenarios: Conservative/Base/Optimistic share parentInstanceId.
  parentInstanceId String?
  parent           ModelInstance?  @relation("ModelInstanceScenarios", fields: [parentInstanceId], references: [id], onDelete: SetNull)
  scenarios        ModelInstance[] @relation("ModelInstanceScenarios")
  scenarioName     String?
  // Sparse: only the nodes the user has overridden vs. node defaults.
  // Shape: { [nodeKey]: number | number[] | boolean | string }
  inputsJson       Json            @default("{}")
  // Setting publicSlug exposes the instance read-only at /models-public/<slug>.
  // No auth required; sliders are local-only (never persisted). Null = private.
  publicSlug       String?         @unique
  createdById      String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([templateId, updatedAt])
  @@index([pitstopId])
  @@index([parentInstanceId])
}

// ── Action Points ─────────────────────────────────────────────────────────────
// Follow-ups that emerge during an activity (PitstopEvent). Always rooted in
// the Goal → Pitstop → PitstopEvent hierarchy — never standalone. goalId and
// pitstopId are denormalized from the PitstopEvent at create-time so Home
// queries (today / overdue / cluster-scoped) are one-hop.
//
// V1 design notes (locked 2026-06-03):
//   - Owner is always the RP themself at creation. `partnerStaffLabel` is a
//     free-text note ("Creche supervisor at Sanjay Gandhinagar") — the RP
//     carries the AP and closes it when the partner action lands. No WhatsApp
//     bridge yet.
//   - Status is open|done|cancelled. No verify step — assignee close is final.
//     Reopen is available from the Done bucket for ~14d via API.
//   - Close authority mirrors pitstop_event.update — owner + ZL/PM/Leader can
//     mark done on the RP's behalf (cluster-scoped).
//   - Capture is manual only in v1: rows added inline on the activity close-out
//     modal. Voice extraction / WhatsApp loop are deferred.
model ActionPoint {
  id String @id @default(cuid())

  // Hierarchy — denormalized for fast queries. Set for source='activity' (the
  // visit follow-up path); any or all may be null for source='adhoc'.
  goalId         String?
  pitstopId      String?
  pitstopEventId String?

  // 'activity' = raised against a visit activity (the original path).
  // 'adhoc'    = free-standing task, outside the goal hierarchy.
  source String @default("activity")

  // Geography for an ad-hoc task that names no goal — mirrors Goal's four levels.
  needsSettlementId String?
  needsClusterId    String?
  needsZoneId       String?
  needsCityId       String?

  // Set when the task is also presented as a catalog item on a live centre —
  // ticking it there closes this row.
  catalogItemKey String?

  // Content
  title             String
  detail            String?
  partnerStaffLabel String? // free-text — "creche supervisor", "ZL Ravi", etc.

  // Ownership / lifecycle
  ownerId      String // = who carries it. Self at creation, except when delegated downward.
  // Who asked, when delegated. Null on a self-raised task. When set and different
  // from ownerId the owner may close the task but not edit it.
  assignedById String?
  dueDate      DateTime
  priority     String   @default("routine") // routine | urgent

  status          String    @default("open") // open | done | cancelled
  closureNote     String?
  closureProofUrl String?
  completedAt     DateTime?
  completedById   String?

  // Bookkeeping
  createdAt       DateTime @default(now())
  createdById     String
  updatedAt       DateTime @updatedAt
  lastUpdatedById String?

  // Relations
  goal                 Goal?                         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  pitstop              Pitstop?                      @relation(fields: [pitstopId], references: [id], onDelete: Cascade)
  pitstopEvent         PitstopEvent?                 @relation(fields: [pitstopEventId], references: [id], onDelete: Cascade)
  owner                User                          @relation("ActionPointOwner", fields: [ownerId], references: [id])
  assignedBy           User?                         @relation("ActionPointAssigner", fields: [assignedById], references: [id])
  createdBy            User                          @relation("ActionPointCreator", fields: [createdById], references: [id])
  lastUpdatedBy        User?                         @relation("ActionPointLastUpdater", fields: [lastUpdatedById], references: [id])
  completedBy          User?                         @relation("ActionPointCompleter", fields: [completedById], references: [id])
  needsSettlement      Settlement?                   @relation("ActionPointNeedsSettlement", fields: [needsSettlementId], references: [id])
  needsCluster         Cluster?                      @relation("ActionPointNeedsCluster", fields: [needsClusterId], references: [id])
  needsZone            Zone?                         @relation("ActionPointNeedsZone", fields: [needsZoneId], references: [id])
  needsCity            City?                         @relation("ActionPointNeedsCity", fields: [needsCityId], references: [id])
  caregiverObservation CaregiverPracticeObservation?

  /// Set when this follow-up came out of grant monitoring, so corrective
  /// actions land in the tracker staff already use rather than a new one.
  fundingBudgetId      String?
  fundingBudget        Budget?                       @relation("ActionPointFundingBudget", fields: [fundingBudgetId], references: [id], onDelete: SetNull)

  @@index([ownerId, status, dueDate])
  @@index([pitstopEventId])
  @@index([pitstopId])
  @@index([goalId])
  @@index([status, dueDate])
  @@index([source, status, dueDate])
  @@index([needsClusterId, status])
  @@index([assignedById, status])
}

// ── Wiki v2 — Articles + Spine ─────────────────────────────────────────────
// New programme-reference wiki. Each programme has a spine (e.g. the EVRAT
// questionnaire for Elderly) of question articles; each question links to
// companion articles in 3 panels (guideline / care_plan / action_manual).
// Articles are atomic units of content: edit once → reflected everywhere they
// appear. The Fork action duplicates an article when a question genuinely
// needs divergent content. See /Users/vishnuharikumar/.claude/plans/async-snacking-hippo.md.

model WikiArticle {
  id            String @id @default(cuid())
  slug          String @unique
  title         String
  // 'question' | 'guideline_appendix' | 'care_plan_derivation' | 'pathway'
  // | 'template' | 'chapter' | 'framework' | 'flag_protocol'
  kind          String
  // Matches NeedsFormulaConfig.domain. 'Elderly' for v1.
  programDomain String
  // TipTap JSON doc. Preserves mentions (wikilinks), tables, formatting.
  contentJson   Json
  // Sort within kind for category pages.
  naturalOrder  Int    @default(0)

  // Soft-delete. Lists, spines, categories, search all filter archivedAt: null.
  archivedAt   DateTime?
  archivedById String?
  createdById  String
  createdAt    DateTime  @default(now())
  updatedById  String
  updatedAt    DateTime  @updatedAt
  // Set on Fork — points to the article this one was forked from. Lets us
  // trace lineage; does NOT propagate edits.
  forkedFromId String?

  createdBy     User                 @relation("WikiArticleCreator", fields: [createdById], references: [id])
  updatedBy     User                 @relation("WikiArticleUpdater", fields: [updatedById], references: [id])
  archivedBy    User?                @relation("WikiArticleArchiver", fields: [archivedById], references: [id])
  forkedFrom    WikiArticle?         @relation("WikiArticleForks", fields: [forkedFromId], references: [id])
  forks         WikiArticle[]        @relation("WikiArticleForks")
  versions      WikiArticleVersion[]
  // Links FROM this article (where this is the question; targets show in fork panels).
  outboundLinks WikiArticleLink[]    @relation("WikiArticleLinkFrom")
  // Links TO this article (where this article appears in someone else's fork panel).
  inboundLinks  WikiArticleLink[]    @relation("WikiArticleLinkTo")
  spineEntries  WikiSpineEntry[]

  @@index([programDomain, kind, naturalOrder])
  @@index([archivedAt])
  @@index([forkedFromId])
}

model WikiArticleVersion {
  id            String   @id @default(cuid())
  articleId     String
  versionNumber Int
  title         String
  contentJson   Json
  savedAt       DateTime @default(now())
  savedById     String
  // Optional change note ("first draft", "fixed typo in para 3", etc.)
  summary       String?

  article WikiArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  savedBy User        @relation("WikiArticleVersionSaver", fields: [savedById], references: [id])

  @@unique([articleId, versionNumber])
  @@index([savedById])
}

model WikiArticleLink {
  id            String @id @default(cuid())
  // The question article (where the fork buttons live).
  fromArticleId String
  // The content article shown in the panel.
  toArticleId   String
  // 'guideline' | 'care_plan' | 'action_manual'
  panel         String
  // Order within the panel for this question.
  ordinal       Int    @default(0)

  from WikiArticle @relation("WikiArticleLinkFrom", fields: [fromArticleId], references: [id], onDelete: Cascade)
  to   WikiArticle @relation("WikiArticleLinkTo", fields: [toArticleId], references: [id], onDelete: Cascade)

  @@unique([fromArticleId, toArticleId, panel])
  // Backlinks ("appears on N questions") + reverse fork-panel lookups.
  @@index([toArticleId, panel])
  @@index([fromArticleId, panel, ordinal])
}

model WikiSpine {
  id            String @id @default(cuid())
  // e.g. 'elderly-evrat-v4'
  slug          String @unique
  title         String
  programDomain String

  entries WikiSpineEntry[]

  @@index([programDomain])
}

model WikiSpineEntry {
  id           String  @id @default(cuid())
  spineId      String
  ordinal      Int
  articleId    String
  // Null = no header break; otherwise render as section header above this entry.
  sectionLabel String?

  spine   WikiSpine   @relation(fields: [spineId], references: [id], onDelete: Cascade)
  article WikiArticle @relation(fields: [articleId], references: [id])

  @@unique([spineId, ordinal])
  @@index([spineId])
}

// ─── Seeding Fellowships launch portal ──────────────────────────────────────
// Self-contained module (like budget). The Excel "Master Checklist" was the
// living spine; sheets 4-9 and the Gantt were derived views. This portal makes
// the checklist + funnel the living master. Time is measured in weeks from
// Week 0 = 22 Jun 2026; calendar dates derive from SeedingConfig.week0Date.

/// Singleton (id always 1) holding the programme's time anchors.
model SeedingConfig {
  id         Int      @id @default(1)
  week0Date  DateTime // 22 Jun 2026 kickoff
  launchWeek Int      @default(14)
  updatedAt  DateTime @updatedAt
}

/// The 4 Phase-1 geographies (data, not hardcoded — extensible).
/// NOTE: geoCount drives every derived funnel target (see lib/seeding/funnel.ts),
/// so this table must hold ONLY real geographies. Central/national outreach is
/// modelled as a null geoId on the outreach tables, never as a 5th row here.
model SeedingGeo {
  id        String            @id @default(cuid())
  key       String            @unique // bangalore_urban | odisha | eastern_up | north_east
  label     String
  sortOrder Int               @default(0)
  funnel    SeedingFunnelGeo?
  members   SeedingMember[]
  subGeos   SeedingSubGeo[]
  channels  SeedingChannel[]
  sessions  SeedingSession[]
  leads     SeedingLead[]
  screeningApplications ScreeningApplication[]
  screeningScopes       ScreeningScope[]
}

/// Top-level workstream (A-E + Launch Gate). Admin add/remove/reorder.
model SeedingWorkstream {
  id         String         @id @default(cuid())
  key        String         @unique // A | B | C | D | E | LAUNCH
  label      String
  color      String         @default("#6366f1")
  sortOrder  Int            @default(0)
  archivedAt DateTime?
  phases     SeedingPhase[]
  tasks      SeedingTask[]
}

/// Grouping level within a workstream (A0, C5, E1, Go-live readiness…).
model SeedingPhase {
  id           String                  @id @default(cuid())
  workstreamId String
  workstream   SeedingWorkstream       @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  label        String
  sortOrder    Int                     @default(0)
  // Which curated Road-to-Launch milestone this phase rolls into (nullable).
  milestoneId  String?
  milestone    SeedingLaunchMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  tasks        SeedingTask[]

  @@index([workstreamId])
  @@index([milestoneId])
}

/// Curated Road-to-Launch milestone — a handful of gates that group phases.
/// Editable in-app; `key` is stable so the importer can re-link phases. The
/// target date is computed from the member phases' latest sub-task due week
/// unless targetWeek is set as an override.
model SeedingLaunchMilestone {
  id         String         @id @default(cuid())
  key        String         @unique
  title      String
  sortOrder  Int            @default(0)
  targetWeek Int?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  phases     SeedingPhase[]
}

enum SeedingTaskStatus {
  not_started
  in_progress
  blocked
  done
}

/// A sub-task on the checklist. Owner is a role label (master tasks stay
/// role-based); "My tasks" maps a member's role+geo to matching tasks.
model SeedingTask {
  id           String            @id @default(cuid())
  workstreamId String
  workstream   SeedingWorkstream @relation(fields: [workstreamId], references: [id], onDelete: Cascade)
  phaseId      String?
  phase        SeedingPhase?     @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  code         String? // "01", "C5.1", "E01"
  title        String // Task (col D) — groups its sub-tasks
  detail       String? // deprecated: old single sub-task text; kept for back-compat
  // Task-level fields are ROLLUPS of the sub-tasks (owner = distinct owners,
  // startWeek/dueWeek = min/max, status = aggregate). Editable directly only
  // when the task has no sub-tasks. Maintained by recomputeTaskRollup().
  ownerRole    String? // seeding role vocab label (see lib/seeding/roles.ts)
  supportRoles String?
  startWeek    Int?
  dueWeek      Int?
  dependsOn    String?
  doneMetric   String?
  status       SeedingTaskStatus @default(not_started)
  notes        String? // blocker note when status = blocked
  sortOrder    Int               @default(0)
  createdById  String?
  createdBy    User?             @relation("SeedingTaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt   DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  subtasks     SeedingSubtask[]

  @@index([workstreamId])
  @@index([phaseId])
  @@index([status])
}

/// A sub-task (sheet col E) under a task — the atomic work item, carrying its
/// own owner, window, done-metric and status. The task's fields roll up from
/// these.
model SeedingSubtask {
  id           String            @id @default(cuid())
  taskId       String
  task         SeedingTask       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  code         String?
  title        String // the sub-task text (col E)
  ownerRole    String?
  supportRoles String?
  startWeek    Int?
  dueWeek      Int?
  dependsOn    String?
  doneMetric   String?
  status       SeedingTaskStatus @default(not_started)
  notes        String?
  sortOrder    Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([taskId])
}

/// Fixed key dates for the always-visible dashboard rail.
model SeedingMilestone {
  id        String   @id @default(cuid())
  label     String
  date      DateTime
  kind      String? // launch | selection | onboarding | orientation | seed_grant …
  sortOrder Int      @default(0)
}

/// Singleton (id always 1): the funnel "blue cell" assumptions. Targets are
/// computed from these (see lib/seeding/funnel.ts), never stored.
model SeedingFunnelConfig {
  id                 Int      @id @default(1)
  fellowsPerGeo      Int      @default(25)
  selectionRatio     Int      @default(100) // applications : fellow
  appBufferPct       Float    @default(0.20)
  leadToApp          Float    @default(0.40)
  coldReachToApp     Float    @default(0.02)
  reachToLead        Float    @default(0.10)
  shareFromWarm      Float    @default(0.70)
  // Outreach-band assumptions: how many sessions the reach target implies, and
  // how many channels those sessions imply. Same rule as the rest of this
  // table — assumptions are stored, targets are always derived from them.
  avgReachPerSession Int      @default(60) // people per held session
  sessionsPerChannel Float    @default(1.5) // sessions an active channel yields
  channelAgreeRate   Float    @default(0.35) // identified → active conversion
  updatedAt          DateTime @updatedAt
}

/// Per-geo funnel actuals. Two halves with different provenance:
///   • reachToDate / leadsToDate are DERIVED and materialised — recomputed from
///     the outreach log by recomputeOutreachRollup() on every session/channel
///     write (the recomputeTaskRollup pattern). Never hand-edit them; the only
///     hand-entered part is the *Opening balance, carried forward once from the
///     hand-typed numbers that predate the outreach log.
///   • appsReceived / screened / shortlisted are still typed by hand — they come
///     from the application portal, which does not exist yet.
model SeedingFunnelGeo {
  id              String     @id @default(cuid())
  geoId           String     @unique
  geo             SeedingGeo @relation(fields: [geoId], references: [id], onDelete: Cascade)
  reachToDate     Int        @default(0) // = reachOpening + Σ held sessions.reachCount
  leadsToDate     Int        @default(0) // = leadsOpening + Σ held sessions.leadsCaptured
  reachOpening    Int        @default(0)
  leadsOpening    Int        @default(0)
  openingNote     String?
  // Materialised outreach counts for the funnel's channel + activity bands.
  sessionsHeld    Int        @default(0)
  sessionsPlanned Int        @default(0)
  channelsActive  Int        @default(0) // stage agreed or active
  channelsTotal   Int        @default(0) // everything except dropped
  rollupAt        DateTime?
  appsReceived    Int        @default(0)
  screened        Int        @default(0)
  shortlisted     Int        @default(0)
  updatedAt       DateTime   @updatedAt
}

// ─── Outreach layer ─────────────────────────────────────────────────────────
// The engine under the funnel. Three nouns:
//   Channel — anything you can reach people through (a college, an alumni
//             network, a partner NGO, a WhatsApp forum, a govt body, a
//             broadcast surface). ONE directory, discriminated by `kind`.
//   Session — one dated act of outreach against a channel. Held sessions are
//             the SOLE source of the funnel's reach + lead actuals.
//   Lead    — an optional NAMED row for warm/high-value people only. A strict
//             subset of Session.leadsCaptured; never summed into the funnel.
// A null geoId means central/national (a pan-India alumni network, a national
// webinar) — it rolls into the totals row, never into a geo row.

enum SeedingChannelKind {
  institution // college, university, ITI, school
  alumni_network
  partner_org // NGO / CSO / CSR partner
  forum_community // youth forum, collective, WhatsApp group, SHG federation
  govt_body // district admin, NYK, DUDA, skill mission
  digital_channel // an owned or borrowed broadcast surface
}

/// Monotonic except `dropped` — see CHANNEL_STAGE_META.rank in lib/seeding/outreach.ts.
enum SeedingChannelStage {
  identified
  contacted
  responded
  agreed
  active
  dropped
}

enum SeedingSessionKind {
  campus_session
  webinar
  info_desk
  meeting
  digital_blast // off-book reach: WhatsApp/email/social — no room, just a count
  other
}

enum SeedingSessionStatus {
  planned
  held
  cancelled
}

enum SeedingLeadStage {
  captured
  nurtured
  applied
  dropped
}

/// Editable list under a geo — NE states, Bangalore clusters, Odisha districts.
/// Closes the pending "sub-geo definition" item in workstream B.
model SeedingSubGeo {
  id         String     @id @default(cuid())
  geoId      String
  geo        SeedingGeo @relation(fields: [geoId], references: [id], onDelete: Cascade)
  key        String // slug, stable within the geo
  label      String
  notes      String?
  sortOrder  Int        @default(0)
  archivedAt DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  channels SeedingChannel[]
  sessions SeedingSession[]
  leads    SeedingLead[]

  @@unique([geoId, key])
  @@index([geoId])
}

/// The one outreach directory. Nullable descriptor columns are only meaningful
/// for some kinds (institutions carry externalCode/district/lat/lng; digital
/// channels carry websiteUrl).
model SeedingChannel {
  id       String              @id @default(cuid())
  geoId    String? // null = central / national
  geo      SeedingGeo?         @relation(fields: [geoId], references: [id], onDelete: SetNull)
  subGeoId String?
  subGeo   SeedingSubGeo?      @relation(fields: [subGeoId], references: [id], onDelete: SetNull)
  kind     SeedingChannelKind
  stage    SeedingChannelStage @default(identified)

  name    String
  /// normaliseName(name) — lowercased, punctuation/whitespace collapsed. The
  /// dedupe key for the paste importer; never shown in the UI.
  nameKey String

  contactName  String?
  contactRole  String?
  contactPhone String?
  contactEmail String?

  externalCode String? // AISHE / UDISE / registration no.
  district     String?
  address      String?
  lat          Float?
  lng          Float?
  websiteUrl   String?

  /// How many people this channel could plausibly put in a room or an inbox.
  /// Planning figure only — never counted as reach.
  estimatedReach Int?

  /// Set when the outreach partner is already an APF partner org. Seeding
  /// channels are deliberately NOT stored in Org — Org feeds the operational
  /// map + settlement partner pickers and must not fill with colleges.
  orgId String?
  org   Org?    @relation("SeedingChannelOrg", fields: [orgId], references: [id], onDelete: SetNull)

  ownerUserId String?
  owner       User?   @relation("SeedingChannelOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  source      String? // how we found it
  notes       String?

  nextActionAt     DateTime?
  firstContactedAt DateTime?
  agreedAt         DateTime?

  // Materialised from this channel's held sessions — recomputeChannelRollup().
  sessionsHeld   Int       @default(0)
  reachToDate    Int       @default(0)
  leadsToDate    Int       @default(0)
  lastActivityAt DateTime?

  origin      String?   @default("manual") // manual | import
  archivedAt  DateTime?
  createdById String?
  createdBy   User?     @relation("SeedingChannelCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sessions SeedingSession[]
  leads    SeedingLead[]

  @@unique([geoId, nameKey])
  @@index([geoId, kind])
  @@index([geoId, stage])
  @@index([subGeoId])
  @@index([orgId])
  @@index([archivedAt])
}

/// One dated act of outreach. Only status = held contributes to the funnel.
/// Off-book reach (a WhatsApp blast, a mailer) is a digital_blast session with
/// a reach count and no channel — so every number still flows through one path
/// and the funnel never needs a manual override.
model SeedingSession {
  id        String               @id @default(cuid())
  geoId     String? // null = central / national
  geo       SeedingGeo?          @relation(fields: [geoId], references: [id], onDelete: SetNull)
  subGeoId  String?
  subGeo    SeedingSubGeo?       @relation(fields: [subGeoId], references: [id], onDelete: SetNull)
  channelId String?
  channel   SeedingChannel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  kind      SeedingSessionKind
  status    SeedingSessionStatus @default(planned)

  title               String
  /// Frozen at creation and never mutated by a reschedule, so slippage can't be
  /// laundered (the PitstopEvent.originalScheduledAt rule).
  originalScheduledAt DateTime
  scheduledAt         DateTime
  heldAt              DateTime?
  location            String?

  /// Planning figure, entered while status = planned. Never counted as reach.
  expectedReach Int?
  /// Actuals — counted into the funnel only when status = held.
  reachCount    Int  @default(0)
  leadsCaptured Int  @default(0)

  notes           String?
  proofUrl        String? // attendance sheet / photo / post link
  cancelledReason String?

  ownerUserId String?
  owner       User?     @relation("SeedingSessionOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("SeedingSessionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  leads SeedingLead[]

  @@index([geoId, status])
  @@index([geoId, heldAt])
  @@index([channelId])
  @@index([subGeoId])
  @@index([archivedAt])
}

/// NAMED register for warm / high-value leads only — a strict SUBSET of
/// SeedingSession.leadsCaptured, never summed into the funnel. This is personal
/// data on a production database: reads are geo-filtered at the query (see
/// canSeeLeadPII), outbound contact affordances are gated on consentAt, and
/// there is deliberately no bulk import or export.
model SeedingLead {
  id        String          @id @default(cuid())
  geoId     String?
  geo       SeedingGeo?     @relation(fields: [geoId], references: [id], onDelete: SetNull)
  subGeoId  String?
  subGeo    SeedingSubGeo?  @relation(fields: [subGeoId], references: [id], onDelete: SetNull)
  channelId String?
  channel   SeedingChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  sessionId String?
  session   SeedingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  name         String
  phone        String?
  email        String?
  ageBand      String? // coarse on purpose — no DOB, no address, no ID numbers
  occupation   String?
  theme        String?
  interestNote String?
  stage        SeedingLeadStage @default(captured)

  /// Stamped when the person agreed to be contacted. Null = the contact fields
  /// must not be used for outbound.
  consentAt       DateTime?
  lastContactedAt DateTime?
  nextActionAt    DateTime?
  appliedAt       DateTime?

  ownerUserId String?
  owner       User?     @relation("SeedingLeadOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("SeedingLeadCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([geoId, stage])
  @@index([sessionId])
  @@index([channelId])
  @@index([archivedAt])
}

/// Who can use the portal + their scope. Central roles have geoId null (all
/// geos); geo roles are scoped to one geography. Role vocab in lib/seeding/roles.ts.
model SeedingMember {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("SeedingMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      String
  geoId     String?
  geo       SeedingGeo? @relation(fields: [geoId], references: [id], onDelete: SetNull)
  createdAt DateTime    @default(now())

  @@unique([userId, role, geoId])
  @@index([userId])
}

// ── Reference tables (seeded from the sheet; read-only pages in v1) ──────────

/// Sheet 12 — Roles, Hires & Responsibilities.
model SeedingRoleDef {
  id                 String  @id @default(cuid())
  role               String
  newHire            String?
  reportsTo          String?
  count              String?
  coreResponsibility String?
  ownsWorkstreams    String?
  inPlaceBy          String?
  sortOrder          Int     @default(0)
}

/// Sheet 10 — Fellowship Execution post-launch arc.
model SeedingExecPhase {
  id         String  @id @default(cuid())
  code       String?
  phase      String
  window     String?
  activities String?
  milestones String?
  quarters   String? // rendered quarter-span label
  sortOrder  Int     @default(0)
}

/// Sheet 11 — Partner-SPOC Interface (provides / spoc / cadence rows).
model SeedingPartnerInterface {
  id        String  @id @default(cuid())
  section   String // provides | spoc | cadence
  colA      String?
  colB      String?
  colC      String?
  colD      String?
  colE      String?
  sortOrder Int     @default(0)
}

// -----------------------------------------------------------------------------
// After-School Centres portal (Moulana Azad Model Schools, Directorate of
// Minorities, Karnataka). One plan per school; three faces over one data model
// (tracker + plan page + export). See /schools and lib/schoolPlan/*.
// -----------------------------------------------------------------------------

enum SchoolPlanStatus {
  draft
  for_review
  approved
}

enum SchoolStepStatus {
  pending
  in_progress
  done
  blocked
  not_applicable
}

enum SchoolStaffPayroll {
  us
  anchor
  specialist
  agency
}

enum SchoolServiceStatus {
  ok
  gap
  unknown
}

enum SchoolComponentDelivery {
  us
  anchor
  specialist
  agency
}

/// One after-school-centre plan for a school. The row is the school + the plan
/// state (a school always has exactly one plan in Phase 1; versioning deferred).
model SchoolPlan {
  id                   String           @id @default(cuid())
  name                 String
  officialName         String?
  diseCode             String?
  schoolType           String? // model | urdu | composite
  addressText          String?
  geoLat               Float?
  geoLng               Float?
  taluk                String?
  district             String?
  ward                 String?
  yearEstablished      Int?
  grades               String?
  sections             String?
  mediums              String[]
  enrolmentBoys        Int?
  enrolmentGirls       Int?
  teachersSanctioned   Int?
  teachersWorking      Int?
  classroomsCount      Int?
  otherRoomsCount      Int?
  timings              String?
  shifts               String?
  vacationMonths       String[]
  headTeacherName      String?
  headTeacherPhone     String?
  sdmcStatus           String?
  deptContactName      String?
  ourLeadUserId        String?
  ourLead              User?            @relation("SchoolPlanOurLead", fields: [ourLeadUserId], references: [id], onDelete: SetNull)
  // Anchor partner as a GrantPartner (the same "partners" registry the Budget
  // module uses). `anchorPartnerName` is retained as a free-text fallback for
  // plans whose anchor isn't yet a GrantPartner row.
  anchorPartnerId      String?
  anchorPartner        GrantPartner?    @relation("SchoolPlanAnchorPartner", fields: [anchorPartnerId], references: [id], onDelete: SetNull)
  anchorPartnerName    String?
  campusAfterHoursUse  String?
  siteAreaSqft         Int?
  builtupAreaSqft      Int?
  surveyStatus         String? // pending | in_progress | complete
  targetChildrenPerDay Int?
  capacityRead         String? // written "capacity read" paragraph on plan page
  mobilisationNotes    String?
  // Phase 3 — public read-only view. When set, the plan is reachable at
  // /schools-public/<slug> without auth (budget + salaries + phones redacted).
  publicSlug           String?          @unique
  // Phase 3 — DJ Halli variant. Interim structure (no as-built survey; carries
  // an interimStructureSpec paragraph in place of §3 space inventory).
  isInterimStructure   Boolean          @default(false)
  interimStructureSpec String?
  planStatus           SchoolPlanStatus @default(draft)
  planVersion          Int              @default(1)
  // Week 0 anchor for the plan's week model (Path C). Null = week model
  // disabled; step/substep due dates are absolute. When set, dueWeek on
  // step + substep drives dueDate via weekToDate(launchDate, dueWeek), and
  // shifting launchDate cascades dueDate updates.
  launchDate           DateTime?
  budgetId             String?          @unique
  budget               Budget?          @relation("SchoolBudget", fields: [budgetId], references: [id], onDelete: SetNull)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  categories  SchoolPlanCategory[]
  steps       SchoolPlanStep[]
  settlements SchoolPlanCatchment[]
  spaces      SchoolPlanSpace[]
  services    SchoolPlanService[]
  components  SchoolPlanComponent[]
  staffing    SchoolPlanStaffing[]
  milestones  SchoolPlanMilestone[]
  risks       SchoolPlanRisk[]
  artifacts   SchoolPlanArtifact[]
  signoff     SchoolPlanSignoff?
  members     SchoolPlanMember[]

  @@index([district])
  @@index([planStatus])
  @@index([anchorPartnerId])
}

/// Per-plan grouping for steps. The 6 default categories (discovery, site_infra,
/// programme_partners, approvals_timeline, financials, governance) are seeded
/// on SchoolPlan.create from lib/schoolPlan/stepTemplate.ts; users can rename,
/// reorder, add, or delete them per school. `key` is set for seeded rows and
/// null for user-added categories.
model SchoolPlanCategory {
  id          String           @id @default(cuid())
  planId      String
  plan        SchoolPlan       @relation(fields: [planId], references: [id], onDelete: Cascade)
  key         String?
  title       String
  description String?
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  steps       SchoolPlanStep[]

  @@unique([planId, key])
  @@index([planId, sortOrder])
}

/// Per-plan step under a category. The 16 seeded steps come from
/// lib/schoolPlan/stepTemplate.ts on SchoolPlan.create; users can add, edit,
/// reorder, delete, or move steps between categories. `key` is set for seeded
/// rows and null for user-added steps. `stepNo` is a per-plan monotonic int
/// (max+1 on add) kept for URL/index stability, not for ordering — display
/// order is (categoryId, sortOrder).
model SchoolPlanStep {
  id                   String               @id @default(cuid())
  planId               String
  plan                 SchoolPlan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  categoryId           String?
  category             SchoolPlanCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  stepNo               Int
  sortOrder            Int                  @default(0)
  key                  String?
  title                String
  description          String?
  planSection          String?
  requiredArtifactType String?
  // If true (default), this step must be Done / N/A for its section (or the
  // plan overall, when planSection is null) to be complete → gates sign-off.
  // False = "optional" step: shown in the tracker but never blocks. Template
  // steps default to true (existing behaviour). User-added steps default true
  // too; the create/edit UI exposes a checkbox to opt out.
  blocksSignoff        Boolean              @default(true)
  ownerUserId          String?
  owner                User?                @relation("SchoolStepOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Role-based owner (Path C). One of SCHOOL_PLAN_ROLES keys. Independent of
  // ownerUserId — both can be set. /my unions the two owners.
  ownerRole            String?
  dueDate              DateTime?
  // Optional user-intent week number relative to plan.launchDate. When set,
  // dueDate is derived from launchDate + dueWeek and re-cascaded when
  // launchDate shifts. Null = row uses absolute dueDate only.
  dueWeek              Int?
  status               SchoolStepStatus     @default(pending)
  blockingNote         String?
  completedAt          DateTime?
  completedById        String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  artifacts            SchoolPlanArtifact[]
  substeps             SchoolPlanSubstep[]

  @@unique([planId, stepNo])
  @@index([status, dueDate])
  @@index([planId, categoryId, sortOrder])
}

/// Optional per-step breakdown. When a SchoolPlanStep has ≥1 substep, its status
/// is rolled up from the substeps (see lib/schoolPlan/rollup.ts) and direct
/// status edits on the step are refused. Zero substeps = step behaves as before.
model SchoolPlanSubstep {
  id            String           @id @default(cuid())
  stepId        String
  step          SchoolPlanStep   @relation(fields: [stepId], references: [id], onDelete: Cascade)
  position      Int              @default(0)
  title         String
  description   String?
  status        SchoolStepStatus @default(pending)
  ownerUserId   String?
  owner         User?            @relation("SchoolSubstepOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  // Path C: role-based owner and week-model dueWeek. See parent SchoolPlanStep
  // for semantics — same rules apply per substep.
  ownerRole     String?
  dueDate       DateTime?
  dueWeek       Int?
  blockingNote  String?
  completedAt   DateTime?
  completedById String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([stepId, position])
  @@index([ownerUserId])
}

model SchoolPlanCatchment {
  id               String     @id @default(cuid())
  planId           String
  plan             SchoolPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  settlementId     String? // FK-by-convention to existing Settlement when available
  name             String
  geoLat           Float?
  geoLng           Float?
  distanceMeters   Int?
  walkMinutes      Int?
  children0to3     Int?
  children3to14    Int?
  children14to18   Int?
  existingServices String?
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
}

model SchoolPlanSpace {
  id                 String     @id @default(cuid())
  planId             String
  plan               SchoolPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  building           String?
  floor              String?
  name               String
  sizeSqm            Float?
  currentUse         String?
  proposedUse        String?
  capacityPerSession Int?
  sessionsPerDay     Int?       @default(1)
  changesNeeded      String?
  structuralFlags    String?
  sortOrder          Int        @default(0)
  createdAt          DateTime   @default(now())
}

model SchoolPlanService {
  id      String              @id @default(cuid())
  planId  String
  plan    SchoolPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  item    String // water | electricity | toilets | lighting | drainage | ro_plant | boundary | internet
  status  SchoolServiceStatus @default(unknown)
  details String?

  @@unique([planId, item])
}

model SchoolPlanComponent {
  id                  String                  @id @default(cuid())
  planId              String
  plan                SchoolPlan              @relation(fields: [planId], references: [id], onDelete: Cascade)
  component           String // creche | library | lab | art_music | sports | computing | youth | community
  offerText           String?
  deliveredBy         SchoolComponentDelivery
  schedule            String?
  childrenPerDay      Int?
  specialistPartnerId String?
  planVetted          Boolean                 @default(false)
  sortOrder           Int                     @default(0)

  @@unique([planId, component])
}

model SchoolPlanStaffing {
  id        String             @id @default(cuid())
  planId    String
  plan      SchoolPlan         @relation(fields: [planId], references: [id], onDelete: Cascade)
  role      String
  count     Int
  payroll   SchoolStaffPayroll
  status    String             @default("identified") // identified | hired | gap
  notes     String?
  sortOrder Int                @default(0)
}

model SchoolPlanMilestone {
  id         String     @id @default(cuid())
  planId     String
  plan       SchoolPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  name       String
  targetDate DateTime?
  dependsOn  String?
  status     String     @default("pending")
  sortOrder  Int        @default(0)
}

model SchoolPlanRisk {
  id          String     @id @default(cuid())
  planId      String
  plan        SchoolPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  description String
  mitigation  String?
  ownerUserId String?
  owner       User?      @relation("SchoolRiskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  status      String     @default("open") // open | mitigated | closed
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
}

/// Any file attached to a school plan: survey drawing, photo, map image,
/// architect design, vendor quote, permission letter, agreement. Uploaded
/// to the private Vercel Blob store via /api/upload/school.
model SchoolPlanArtifact {
  id           String          @id @default(cuid())
  planId       String
  plan         SchoolPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  stepId       String?
  step         SchoolPlanStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  kind         String // survey_drawing | photo | map | architect_design | vendor_quote | budget_working | permission_letter | partner_agreement | other
  name         String
  url          String
  size         Int?
  mimeType     String?
  caption      String?
  uploadedById String?
  uploadedBy   User?           @relation("SchoolArtifactUpload", fields: [uploadedById], references: [id], onDelete: SetNull)
  version      Int             @default(1)
  planSection  String?
  createdAt    DateTime        @default(now())

  @@index([planId, kind])
}

model SchoolPlanSignoff {
  id            String     @id @default(cuid())
  planId        String     @unique
  plan          SchoolPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  preparedById  String?
  preparedAt    DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  reviewerNotes String?
  approvedById  String?
  approvedAt    DateTime?
  approvalNotes String?
}

/// Thin membership like SeedingMember. Role scopes visibility;
/// planId=null means "all plans for their role".
model SchoolPlanMember {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("SchoolPlanMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role      String // central_lead | city_lead | school_owner | anchor_partner | viewer
  planId    String?
  plan      SchoolPlan? @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, role, planId])
  @@index([userId])
}

/// Shared team state for a recruitment scouting doc (/recruitment/[slug]).
/// One row per doc slug; the client PUTs the full state blob (scores, verdicts,
/// notes, question-asked ticks). `version` bumps on every write so pollers can
/// detect teammate edits. Gated in the API route via `recruitment.read`.
model RecruitmentScoutState {
  slug        String   @id
  stateJson   Json     @default("{}")
  version     Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("RecruitmentScoutUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// Recruitment location — city-level context shared across many JDs for the same
/// city. Carries language, salary bands, local reference orgs and location-
/// specific red flags so five Chennai JDs don't restate "Tamil-primary, own
/// two-wheeler". Promoted to a first-class row so we can grow it (mobility
/// defaults, seasonal caveats, etc.) without touching every JD.
model RecruitmentLocation {
  id                 String    @id @default(cuid())
  slug               String    @unique
  city               String
  state              String?
  country            String    @default("IN")
  primaryLanguage    String? // "Tamil", "Kannada", "Hindi", …
  // Free-form JSON keyed by seniority band, e.g. { entry: "₹18-22k/mo", mid: "…" }.
  // Kept opaque here so orgs pick their own bands without a schema change.
  localSalaryBands   Json?
  localReferenceOrgs String[]  @default([]) // orgs a serious candidate could plausibly cite
  localRedFlags      String[]  @default([]) // "commercial-only banking background", …
  mobilityDefault    String? // "own-two-wheeler" | "public-transport" | "none"
  notes              String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  archivedAt         DateTime?

  /// JDs whose PRIMARY location this is (drives the JD slug + the default pick
  /// at generate time). A JD posted in several cities also appears in `jobs`
  /// below via the many-to-many — always count both when checking whether a
  /// location is still referenced.
  primaryForJobs RecruitmentJob[]         @relation("RecruitmentJobPrimaryLocation")
  /// Every JD that runs in this city, primary or not.
  jobs           RecruitmentJob[]         @relation("RecruitmentJobLocations")
  scoutingDays   RecruitmentScoutingDay[]
}

/// A saved job description — reusable across many scouting days. Rubric fields
/// (redFlagRules/yellowFlagRules/scrutiniseFor/lockedAxes) are populated but
/// only wired into the SYSTEM prompt from Phase 3 — Phase 1 uses generic
/// defaults. A JD is snapshot-frozen into every scouting day at generation time
/// (see RecruitmentScoutingDay.jobSnapshotJson) so subsequent JD edits don't
/// retroactively change old scouting docs.
model RecruitmentJob {
  id        String  @id @default(cuid())
  slug      String  @unique
  title     String
  seniority String? // entry | mid | senior | lead

  // A JD can be posted in several cities (one role, same rubric, many
  // locations) — `locations` is the full set. But GENERATION is inherently
  // single-city: language, reference orgs, local red flags and mobility all go
  // into the prompt from ONE location, so every scouting day resolves exactly
  // one (see RecruitmentScoutingDay.locationId). `locationId` is the PRIMARY:
  // it drives the slug and is the default pick when a day is generated.
  // Invariant: the primary is always also a member of `locations`.
  locationId String
  location   RecruitmentLocation   @relation("RecruitmentJobPrimaryLocation", fields: [locationId], references: [id])
  locations  RecruitmentLocation[] @relation("RecruitmentJobLocations")

  dayToDay          String   @default("") // markdown — what the role actually does
  mustHaves         String[] @default([])
  niceToHaves       String[] @default([])
  hardDisqualifiers String[] @default([])
  salaryBand        String? // free-text; private — read-gated separately if needed

  theme String @default("football") // football | neutral
  notes String @default("") // free-text extra context (replaces upload-form `context`)

  // Rubric — nullable/empty falls back to generic defaults inside the prompt template.
  redFlagRules    String[] @default([]) // role-specific red flags (Phase 3 wiring)
  yellowFlagRules String[] @default([]) // role-specific yellow flags (Phase 3 wiring)
  scrutiniseFor   String[] @default([]) // extra things to look for (Phase 3 wiring)
  lockedAxes      String[] @default([]) // 6 fixed radar axes; empty = model picks per pool

  // Populated when the JD was extracted from an uploaded doc (Phase 2).
  sourceDocUrl String?
  extractedAt  DateTime?

  createdById String?
  createdBy   User?     @relation("RecruitmentJobCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  archivedAt  DateTime?

  scoutingDays RecruitmentScoutingDay[]
  batchRuns    RecruitmentBatchRun[]
}

/// A scouting day = one JD + one CV pool → one HTML doc. Rendered HTML still
/// lives in the private blob store (`recruitment/docs/<slug>.html`); this row
/// is the DB-side source of truth so we can re-render if the template changes
/// and later extract per-candidate scoring rows for cross-day comparability
/// without re-generating. `jobId` is nullable so legacy blob-only docs still
/// show up in listings.
model RecruitmentScoutingDay {
  id              String               @id @default(cuid())
  slug            String               @unique
  jobId           String?
  job             RecruitmentJob?      @relation(fields: [jobId], references: [id], onDelete: SetNull)
  /// Which of the JD's cities this day was run for — the one whose context was
  /// baked into the prompt. Nullable: legacy days (and JD-less blob docs)
  /// predate multi-location, and their city lives in jobSnapshotJson.location.
  locationId      String?
  location        RecruitmentLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  /// This desk's role genuinely has NO location — remote, national, or a
  /// central team. Distinct from the "unplaced" desk, where the city is simply
  /// not known yet: unplaced asks the recruiter to work out where each person
  /// belongs, this one must never ask at all. `locationId` is null for both,
  /// which is why this is a flag rather than something inferred from absence.
  /// The prompt side of the same fact is the NO_CITY sentinel frozen into
  /// jobSnapshotJson.location.city (lib/recruitment/systemPrompt.ts): this
  /// column is for queries and chips, the sentinel is what every later
  /// re-scout reads. Write both or neither.
  /// A JD is still required — only the location is optional.
  notCitySpecific Boolean              @default(false)
  /// Set when an EXISTING desk's location was changed after it was scouted.
  /// The candidate write-ups were judged against the old location and are NOT
  /// rewritten by the change, so the desk page carries a standing warning
  /// until someone re-scouts. Null = never changed, or changed with a re-scout
  /// in the same operation.
  locationChangedAt DateTime?
  /// Groups the desks produced by ONE multi-city run: a single posting drew
  /// CVs for several cities, triage split them per city, and each city got its
  /// own desk (generation is single-city — see lib/recruitment/locations.ts).
  /// Null for an ordinary one-city desk. Not a foreign key: a desk outlives
  /// the run that made it, and the run row (RecruitmentBatchRun, whose id IS
  /// this value) is deletable once the desks exist without orphaning them.
  batchId         String?
  matchday        DateTime?
  title           String
  // The full JD frozen at generation time so subsequent JD edits don't rewrite
  // the doc's provenance. Same snapshot-on-use pattern as CentreCatalog.snapshot.
  jobSnapshotJson Json?
  // Full ScoutDocData (candidates + axes + headlines + …). The HTML is a render
  // of this; Phase 3 extracts per-candidate rows from here for comparability.
  snapshotJson    Json
  renderedBlobUrl String?
  createdById     String?
  createdBy       User?                @relation("RecruitmentScoutingDayCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([jobId])
  @@index([locationId])
  @@index([batchId])
}

/// One multi-city scouting run, owned by the SERVER.
///
/// A run builds one desk per city, and each desk is built in chunks of CVs
/// because a single Claude call for a large pool cannot finish inside the
/// 300s function ceiling. That is a ~25-minute sequence of model calls. It
/// used to be driven by a loop in the recruiter's browser, with progress held
/// in a React ref: one dropped connection ended the run (89-CV run,
/// 2026-09-22 — 48 of 89 CVs scouted, `TypeError: Failed to fetch`, no
/// server-side error at all), and a page refresh lost the resume state
/// entirely, costing a 20-minute re-upload.
///
/// So the plan lives here instead. The browser posts it once and may close;
/// the runner drains it chunk by chunk (lib/recruitment/batchRunner.ts),
/// records progress after every COMMITTED chunk, and a cron re-kicks any run
/// whose lock has gone stale. Resume is therefore exact — never "re-send the
/// chunk the client last heard about", which duplicated candidates.
model RecruitmentBatchRun {
  /// Also the `batchId` stamped on every desk this run produces.
  id       String          @id
  jobId    String?
  job      RecruitmentJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title    String
  matchday DateTime?

  /// running | done | failed. `failed` is terminal only until someone resumes
  /// it — the plan is still intact, so a resume picks up at the first
  /// uncommitted chunk.
  status String @default("running")

  /// BatchPlan (lib/recruitment/batchRunner.ts): every desk, its CV refs, its
  /// slug once created, and how many of its CVs are COMMITTED. The one source
  /// of truth for what still has to run.
  planJson Json

  /// Why the run stopped, verbatim for the recruiter. Cleared on resume.
  error    String?
  /// Consecutive failures of the CURRENT chunk. Reset on every commit; at
  /// MAX_ATTEMPTS the run parks as `failed` rather than burning model spend.
  attempts Int     @default(0)

  /// Held by the drain that is working right now. Stale (or null) means no
  /// worker owns the run and the cron may take it over. Not a real lock —
  /// a lease, which is what survives a function being killed mid-chunk.
  lockedAt DateTime?

  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  createdById String?
  createdBy   User?     @relation("RecruitmentBatchRunCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status, lockedAt])
  @@index([jobId])
}

// ════════════════════════════════════════════════════════════════════════════
// FIELD-OPS SURFACE (/field) — the minimal RP spine
//
// An epoch reset of urban operations & setup. Goal IS the intervention (see the
// fieldAnchorAt/overallSlaDays/cadence* columns above). The old
// Pitstop → ChecklistItem → PitstopEvent triple collapses into ONE FieldStep unit.
// These tables are purely additive; the old spine is left intact and readable so
// /operations keeps working during the transition. No indicators, no journeys —
// this is a project/team-management layer, not an M&E layer.
// ════════════════════════════════════════════════════════════════════════════

enum FieldStepKind {
  Setup // one-time setup task with an SLA, part of the go-live sequence
  Visit // recurring task performed on each cadence visit of a live intervention
}

enum FieldStepStatus {
  Todo
  InProgress
  Blocked // derived-cached: this step's blockedBy predecessor is not yet Done
  Done
  Skipped // N/A for this intervention (soft-remove; never hard delete)
}

// One collapsed step — replaces Pitstop + ChecklistItem + PitstopEvent.
// kind=Setup: a dated setup task on the go-live sequence (completion lives here).
// kind=Visit: a RECIPE row ("do this every visit"); per-occurrence completion
// lives in FieldVisitStep, not here.
model FieldStep {
  id     String        @id @default(cuid())
  goalId String // = the intervention (existing Goal). No separate intervention table.
  kind   FieldStepKind
  title  String
  order  Int           @default(0)

  // Provenance — which template slot this materialised from. (templateSlug, stepKey)
  // is the stable identity used by template re-sync. Both null = ad-hoc RP-added step.
  templateSlug String?
  stepKey      String?

  // Workstream label, copied from SetupStepTemplate.phaseTag at materialise /
  // resync / backfill time. Null = untagged (the step still counts, it just has
  // no phase name). See lib/field/phase.ts deriveFieldPhase.
  phaseTag String?

  // ── Setup semantics ──────────────────────────────────────────────────────
  slaDays      Int? // step SLA in days from its start anchor
  startSlaDays Int? // days after the intervention anchor that this step may start
  blockedByKey String? // ONE predecessor step's stepKey (finish-to-start). Null = parallel.
  dueDate      DateTime? // materialised deadline (anchor + startSlaDays + slaDays)

  // ── Visit semantics ──────────────────────────────────────────────────────
  mandatory Boolean @default(true) // blocksSignoff equivalent

  // ── Form attachment ───────────────────────────────────────────────────────
  formKind   String? // null | "questionnaire" | "caregiver_practices"
  formSchema Json? // questionnaire field defs (null for caregiver_practices — uses its own tables)

  // ── Completion (setup steps only; Visit recipes stay Todo) ─────────────────
  status          FieldStepStatus @default(Todo)
  answers         Json? // questionnaire answers blob for a Setup step
  completedById   String?
  completedAt     DateTime?
  startedAt       DateTime?
  // Last actor to touch this row, whatever the outcome. Unlike completedById it
  // SURVIVES A REOPEN — which is the whole point: without it, undoing a
  // completion erases every trace of who had completed it. Pairs with AuditLog.
  lastUpdatedById String?

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  goal          Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  completedBy   User?            @relation("FieldStepCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  lastUpdatedBy User?            @relation("FieldStepUpdater", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  visitSteps    FieldVisitStep[]

  @@index([goalId, kind, order])
  @@index([goalId, status])
  @@index([templateSlug, stepKey])
}

// One occurrence of a cadence visit to a live intervention. Replaces the parent
// PitstopEvent(type=Visit). Cadence compliance counts these per month.
model FieldVisit {
  id           String    @id @default(cuid())
  goalId       String
  scheduledFor DateTime // the month/period bucket this visit belongs to
  arrivedAt    DateTime? // "I have reached" stamp
  arrivedById  String?
  closedAt     DateTime? // visit signed off
  closedById   String?
  note         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  goal                  Goal                           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  arrivedBy             User?                          @relation("FieldVisitArriver", fields: [arrivedById], references: [id], onDelete: SetNull)
  closedBy              User?                          @relation("FieldVisitCloser", fields: [closedById], references: [id], onDelete: SetNull)
  steps                 FieldVisitStep[]
  caregiverObservations CaregiverPracticeObservation[]

  @@index([goalId, scheduledFor])
}

// Per-visit tick of a Visit-recipe step. Replaces the child PitstopEvent + its tick.
model FieldVisitStep {
  id              String          @id @default(cuid())
  visitId         String
  stepId          String // → FieldStep(kind=Visit) recipe row
  status          FieldStepStatus @default(Todo)
  answers         Json? // questionnaire answers for this occurrence
  completedById   String?
  completedAt     DateTime?
  // Survives an untick, unlike completedById. See FieldStep.lastUpdatedById.
  lastUpdatedById String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  visit         FieldVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  step          FieldStep  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  completedBy   User?      @relation("FieldVisitStepCompleter", fields: [completedById], references: [id], onDelete: SetNull)
  lastUpdatedBy User?      @relation("FieldVisitStepUpdater", fields: [lastUpdatedById], references: [id], onDelete: SetNull)

  @@unique([visitId, stepId])
  @@index([stepId, status])
}

// ── Templates (flat, one row per step) ───────────────────────────────────────

// Per-domain setup recipe: ordered SLA'd steps materialised into FieldStep(kind=Setup).
model SetupStepTemplate {
  id           String   @id @default(cuid())
  domain       String // matches Goal.needsDomain e.g. "creche"
  order        Int      @default(0)
  stepKey      String // stable slug → FieldStep.stepKey
  title        String
  slaDays      Int?
  startSlaDays Int?
  blockedByKey String? // predecessor stepKey (null = parallel)
  // Workstream label this step belongs to (Permissions | Team | Infrastructure |
  // Baseline | Training | Mobilisation | Monitoring | Live | …). Derived from the
  // legacy TemplatePitstopDef.progressTag; free-text so a domain can coin its own.
  // Drives the "Infrastructure · 3/9" phase label and the manager phase lens.
  phaseTag     String?
  formKind     String? // null | "checklist" | "questionnaire" | "caregiver_practices"
  formSchema   Json?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([domain, stepKey])
  @@index([domain, order])
}

// Per-domain visit recipe: steps materialised into FieldStep(kind=Visit) at go-live.
model VisitStepTemplate {
  id         String   @id @default(cuid())
  domain     String
  order      Int      @default(0)
  stepKey    String
  title      String
  mandatory  Boolean  @default(true)
  formKind   String?
  formSchema Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([domain, stepKey])
  @@index([domain, order])
}

// Per-domain config: label, geo grain, overall setup SLA, default live cadence.
model FieldDomainConfig {
  domain         String   @id // "creche", "elderly", …
  label          String
  unit           String   @default("settlement") // "settlement" | "cluster"
  overallSlaDays Int?
  cadenceCount   Int?
  cadencePeriod  String? // "week" | "month"
  hasLivePhase   Boolean  @default(true)
  // Whether steps in this domain may attach the `caregiver_practices` form
  // (the shared quality-of-care observation catalog). Creche-only today.
  caregiverForm  Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // RPs who work this domain. Empty on the user side = unrestricted.
  rps User[] @relation("RPFieldDomains")
}

// ── Seeding: application screening ─────────────────────────────────────────
//
// Applications arrive from the application portal (intake API) or a spreadsheet
// import, get an AI draft against the geography's rubric, and are then scored
// and decided by people: L2 screeners (Shortlist / Hold / Reject), then the
// geography lead at L3 (Approve / Reject / Hold). See lib/seeding/screening/.

enum ScreeningStatus {
  new         // awaiting an L2 read
  l2_hold     // held at L2; needs a second L2 read
  l3_pending  // shortlisted; awaiting the geography lead
  l3_hold
  approved
  rejected
}

model ScreeningApplication {
  id            String          @id @default(cuid())
  /// The application portal's reference. Intake is idempotent on it.
  ref           String          @unique
  geoId         String?
  geo           SeedingGeo?     @relation(fields: [geoId], references: [id], onDelete: SetNull)
  email         String
  name          String
  phone         String?
  state         String?
  district      String?
  block         String?
  theme         String?
  isGroup       Boolean         @default(false)
  /// Structured form answers, as { label: value }. Shape follows the portal.
  profile       Json            @default("{}")
  /// Long-form answers and the statement of purpose: [{ key, label, text }].
  answers       Json            @default("[]")
  /// Group members, entered by the primary applicant: [{ name, ... }].
  members       Json            @default("[]")
  /// Criteria the portal computed as below threshold: [{ criterion, detail }].
  criteriaFlags Json            @default("[]")
  /// Uploaded files: [{ kind, name, url }].
  documents     Json            @default("[]")
  cvText        String?
  sopText       String?
  status        ScreeningStatus @default(new)
  /// red_flag | safeguarding | low_dimension | divergent
  flags         String[]        @default([])
  /// People who declared a conflict of interest; they never see it again.
  conflictUserIds String[]      @default([])
  source        String          @default("import")
  submittedAt   DateTime?

  /// pending | running | done | failed | off
  aiStatus        String    @default("pending")
  /// { scores: { [dimKey]: { score, evidence } }, summary, concerns[] }
  aiDraft         Json?
  aiRubricVersion Int?
  aiError         String?
  aiAttempts      Int       @default(0)
  aiLockedAt      DateTime?

  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  reviews   ScreeningReview[]
  events    ScreeningEvent[]

  @@index([geoId, status])
  @@index([aiStatus, aiLockedAt])
  @@index([email])
}

model ScreeningReview {
  id            String               @id @default(cuid())
  applicationId String
  application   ScreeningApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  /// l2 | l3
  level         String
  reviewerId    String?
  reviewer      User?                @relation("ScreeningReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  /// { [dimKey]: 1..5 }
  scores        Json
  /// Null when a lead decided on the screeners' scores without re-scoring.
  total         Float?
  /// The rubric as it stood when this review was made, so a later edit to the
  /// rubric never changes a recorded total.
  rubric        Json
  /// shortlist | hold | reject | approve
  decision      String
  justification String
  createdAt     DateTime             @default(now())

  @@index([applicationId])
  @@index([reviewerId, createdAt])
}

/// Audit trail: every decision, flag, reopen, import and rubric change.
model ScreeningEvent {
  id            String                @id @default(cuid())
  applicationId String?
  application   ScreeningApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String?
  actor         User?                 @relation("ScreeningEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  type          String
  detail        Json?
  createdAt     DateTime              @default(now())

  @@index([applicationId, createdAt])
  @@index([type, createdAt])
}

/// The scoring rubric: "default", or a geography key for that geography's own.
model ScreeningRubric {
  id          String   @id @default(cuid())
  key         String   @unique
  version     Int      @default(1)
  /// [{ key, label, description, weight, groupWeight, groupOnly, anchors: { "1","3","5" } }]
  dimensions  Json
  /// What reviewers and the AI draft should know about this geography.
  guidance    String   @default("")
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model ScreeningSettings {
  id         Int      @id @default(1)
  advanceMin Int      @default(70)
  holdMin    Int      @default(50)
  /// Two L2 totals further apart than this go to the geography lead.
  divergence Int      @default(15)
  dailyCap   Int      @default(20)
  aiEnabled  Boolean  @default(true)
  updatedAt  DateTime @updatedAt
}

/// Narrows an L2 screener to some districts of a geography. No row = the whole geography.
model ScreeningScope {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation("ScreeningScopeUser", fields: [userId], references: [id], onDelete: Cascade)
  geoId     String
  geo       SeedingGeo @relation(fields: [geoId], references: [id], onDelete: Cascade)
  districts String[]   @default([])

  @@unique([userId, geoId])
}

// ═══════════════════════════════════════════════════════════════════════════════
// GRANT LIFECYCLE
//
// Everything below closes the chain between "a budget exists" and "a grant was
// decided, contracted, released, reported on and closed". Before this, a grant
// became `approved` as a side effect of configuring reporting, a conditional
// approval was indistinguishable from a clean one the next day, "released"
// existed nowhere, and nothing ever ended.
//
// Placement: these live in the MAIN database, not the review DB. They need real
// foreign keys to Budget / Org / User and must transact with budget writes; the
// review DB has neither and is reached by raw SQL. The cross-DB link to a
// review-portal assembly stays a soft pointer with no FK (`assemblyId`), and is
// never pretended to be atomic.
//
// Money: every amount here is `Decimal(14,2)`. The legacy `Float` columns on
// BudgetLine and BudgetReportLine are swept separately — see
// prisma/migrations-pending/README.md. Reconciling against a bank statement in
// binary floating point is not recoverable.
// ═══════════════════════════════════════════════════════════════════════════════

// ── 1.1 The decision of record ───────────────────────────────────────────────

enum GrantDecisionOutcome {
  approved
  approved_with_conditions
  deferred
  declined
  withdrawn
}

enum GrantDecisionForum {
  /// Governing council / board — the ₹1 Cr-and-above forum today.
  gc
  /// Delegated internal authority below the board threshold.
  internal
  /// A circulated resolution rather than a convened meeting.
  written_resolution
}

/// The act of deciding on a grant, as its own record.
///
/// Before this, approval was a side effect of `setReportConfig` writing
/// `status: "approved"` on the Budget, so there was no answer to who decided,
/// when, in which forum, on what conditions, or on which version of the
/// numbers.
model GrantDecision {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  outcome GrantDecisionOutcome
  forum   GrantDecisionForum
  /// The date the decision was taken — NOT the date it was keyed in.
  decidedOn DateTime @db.Date

  /// The amount actually approved. Need not equal the budget's computed total:
  /// a committee may approve less, and that divergence is the point of
  /// `variationNote` rather than something to reconcile away.
  approvedAmount Decimal  @db.Decimal(14, 2)
  variationNote  String?
  /// Approved horizon, where the committee shortened or extended it.
  approvedMonths Int?

  /// The budget's lines exactly as approved, frozen here. An amendment edits
  /// the live budget and records a NEW decision carrying its own snapshot;
  /// variance is snapshot-vs-live via lib/budget/baselineDiff.ts. Cloning the
  /// Budget row instead is not an option — eight models key to budgetId and two
  /// of them are @unique, so a clone would split one grant's reporting history.
  budgetSnapshot Json @default("{}")

  /// True when the snapshot above was taken LONG AFTER the decision it records
  /// — a grant approved before this system existed, written up retrospectively.
  ///
  /// It matters because the snapshot then holds TODAY's budget lines, not the
  /// ones the committee actually saw, so any snapshot-vs-live variance computed
  /// from it is fiction. Readers must refuse to report variance rather than
  /// present a plausible number nobody can source.
  baselineIsReconstructed Boolean @default(false)
  /// Where the figures came from, when reconstructed: minutes, an email, a
  /// signed agreement. Required by the recording path when the flag is set.
  reconstructionNote      String?

  /// Required on deferred / declined / withdrawn.
  reasonCode String?
  reasonNote String?

  /// Soft pointer at the review-portal assembly this decision came from. No FK:
  /// different database. Null for decisions recorded directly.
  assemblyId String?

  /// The decision this one replaces. A deferral keeps the assembly OPEN and
  /// re-presentation is a second decision on the same assembly, so this chain
  /// is the audit answer to "how many times did this go to the board".
  supersedesId String?        @unique
  supersedes   GrantDecision? @relation("DecisionRevision", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy GrantDecision? @relation("DecisionRevision")

  meetingId String?
  meeting   GrantMeeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  recordedById String?
  recordedBy   User?    @relation("GrantDecisionRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  conditions GrantCondition[]
  votes      GrantDecisionVote[]
  agreements GrantAgreement[]
  risks      Risk[]              @relation("RiskSourceDecision")

  @@index([budgetId, decidedOn])
  @@index([outcome, decidedOn])
  @@index([assemblyId])
}

/// When a condition has to be satisfied. The timing is what makes a condition
/// mechanical rather than decorative: it decides which gate it blocks.
enum GrantConditionTiming {
  pre_disbursement
  pre_tranche
  during_grant
  pre_closure
}

enum GrantConditionStatus {
  open
  discharged
  waived
}

/// A condition attached to an approval. The appraisal schema already defined a
/// `Condition` shape, but nothing carried it forward — so a conditional
/// approval looked exactly like a clean one the following day.
model GrantCondition {
  id         String        @id @default(cuid())
  decisionId String
  decision   GrantDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  text   String
  timing GrantConditionTiming
  /// For pre_tranche: which tranche this blocks. Null = every tranche.
  blocksTrancheNumber Int?

  status GrantConditionStatus @default(open)
  dueOn  DateTime? @db.Date

  dischargedById   String?
  dischargedBy     User?     @relation("ConditionDischarger", fields: [dischargedById], references: [id], onDelete: SetNull)
  dischargedAt     DateTime?
  dischargeNote    String?
  /// Waiving a condition is the quietest way to approve money without
  /// appearing to, so it carries its own authority check and its own note.
  waivedById       String?
  waivedBy         User?     @relation("ConditionWaiver", fields: [waivedById], references: [id], onDelete: SetNull)
  waivedAt         DateTime?
  waiverNote       String?

  documents GrantDocument[]
  createdAt DateTime @default(now())

  @@index([decisionId, status])
  @@index([status, timing, dueOn])
}

/// A convened approval forum. Several decisions per meeting.
model GrantMeeting {
  id       String             @id @default(cuid())
  forum    GrantDecisionForum
  heldOn   DateTime           @db.Date
  reference String?
  /// Attendance as names + roles: committee members are frequently not users.
  attendance Json             @default("[]")
  minutesNote String?

  decisions GrantDecision[]
  documents GrantDocument[]
  createdAt DateTime @default(now())

  @@index([forum, heldOn])
}

enum GrantVote {
  for
  against
  abstained
  recused
}

/// An individual's vote, where the forum records them. `recused` is pre-filled
/// from live conflict declarations when attendance is entered.
model GrantDecisionVote {
  id         String        @id @default(cuid())
  decisionId String
  decision   GrantDecision @relation(fields: [decisionId], references: [id], onDelete: Cascade)

  /// A user where the voter has a login; otherwise the name as minuted.
  userId    String?
  user      User?   @relation("GrantVoter", fields: [userId], references: [id], onDelete: SetNull)
  voterName String?

  vote GrantVote
  note String?

  @@index([decisionId])
}

// ── 1.2 Contracting and the grant document set ───────────────────────────────

enum GrantAgreementStatus {
  drafting
  sent_for_signature
  executed
  terminated
}

/// The agreement for one budget. An amendment gets its own agreement row
/// chained by `amendsId` — a variation deed is a second document, even though
/// the budget it varies is edited in place.
model GrantAgreement {
  id       String @id @default(cuid())
  budgetId String @unique
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Restrict)

  /// The decision this agreement gives effect to.
  decisionId String?
  decision   GrantDecision? @relation(fields: [decisionId], references: [id], onDelete: SetNull)

  status    GrantAgreementStatus @default(drafting)
  reference String?

  /// Signatories as names + roles rather than FKs: the grantee's signatory is
  /// usually not a Pitstops user, and the internal one may have left.
  granteeSignatoryName String?
  granteeSignatoryRole String?
  granteeSignedOn      DateTime? @db.Date
  funderSignatoryName  String?
  funderSignatoryRole  String?
  funderSignedOn       DateTime? @db.Date

  executedOn    DateTime? @db.Date
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date

  terminatedOn      DateTime? @db.Date
  terminationReason String?

  /// The release rhythm this grant's money follows. Annual is the norm; creche
  /// and urban operational grants run quarterly or half-yearly. The tranche
  /// generator splits each budget year's total across this frequency.
  trancheFrequency TrancheFrequency @default(annual)

  /// The agreement this one amends (a variation deed).
  amendsId  String?         @unique
  amends    GrantAgreement? @relation("AgreementAmendment", fields: [amendsId], references: [id], onDelete: SetNull)
  amendedBy GrantAgreement? @relation("AgreementAmendment")

  signoff   GrantAgreementSignoff?
  documents GrantDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, executedOn])
}

/// Internal clearance before the agreement goes out. The SchoolPlanSignoff
/// shape, which already works one module over.
model GrantAgreementSignoff {
  id          String         @id @default(cuid())
  agreementId String         @unique
  agreement   GrantAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  preparedById String?
  preparedBy   User?     @relation("AgreementPreparer", fields: [preparedById], references: [id], onDelete: SetNull)
  preparedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("AgreementReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewerNotes String?
  approvedById String?
  approvedBy   User?     @relation("AgreementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  approvedAt   DateTime?
  approvalNotes String?
}

enum GrantDocumentKind {
  proposal
  dd_evidence
  appraisal_note
  board_minutes
  agreement_draft
  agreement_executed
  amendment_deed
  condition_evidence
  budget_workbook
  financial_report
  narrative_report
  utilisation_certificate
  audited_accounts
  fcra_return
  disbursement_advice
  bank_statement
  asset_register
  closure_report
  other
}

/// One home for grant documents. Until now they lived in five unrelated places
/// (Attachment, review-portal blobs, ScreeningApplication.documents JSON,
/// SchoolPlanArtifact, BudgetReport scan URLs) with no document set and no
/// notion of completeness.
model GrantDocument {
  id       String            @id @default(cuid())
  kind     GrantDocumentKind
  title    String
  fileUrl  String
  mimeType String?
  sizeBytes Int?

  /// Versioning, as SchoolPlanArtifact does it: a new version is a new row.
  version    Int     @default(1)
  supersedesId String? @unique
  supersedes   GrantDocument? @relation("DocumentVersion", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy GrantDocument? @relation("DocumentVersion")

  /// Attachment points. A document hangs off exactly one of these.
  budgetId      String?
  budget        Budget?          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  agreementId   String?
  agreement     GrantAgreement?  @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  conditionId   String?
  condition     GrantCondition?  @relation(fields: [conditionId], references: [id], onDelete: Cascade)
  meetingId     String?
  meeting       GrantMeeting?    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  disbursementId String?
  disbursement  Disbursement?    @relation(fields: [disbursementId], references: [id], onDelete: Cascade)
  closureId     String?
  closure       GrantClosure?    @relation(fields: [closureId], references: [id], onDelete: Cascade)
  proposalId    String?
  proposal      Proposal?        @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  uploadedById String?
  uploadedBy   User?    @relation("GrantDocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([budgetId, kind])
  @@index([kind, createdAt])
}

/// What documents a grant must hold, and by when. Data rather than code so the
/// set can change per granting unit without a deploy.
model GrantDocumentRequirement {
  id   String            @id @default(cuid())
  kind GrantDocumentKind
  /// Null = applies to every granting unit.
  grantingUnitId String?
  grantingUnit   GrantingUnit? @relation(fields: [grantingUnitId], references: [id], onDelete: Cascade)

  /// Which gate this document blocks, mirroring GrantConditionTiming.
  timing   GrantConditionTiming
  isActive Boolean @default(true)
  note     String?

  @@unique([kind, grantingUnitId, timing])
}

// ── 1.3 Tranches and disbursement ────────────────────────────────────────────

enum TrancheFrequency {
  annual
  half_yearly
  quarterly
}

enum TrancheStatus {
  planned
  blocked
  requested
  approved
  released
  partially_released
  cancelled
}

enum DisbursementStatus {
  pending
  released
  failed
  returned
  recovered
}

/// The release schedule. Generated from the BUDGET's per-year amounts (not the
/// agreement period) split across GrantAgreement.trancheFrequency.
///
/// Only the current grant year is committed. Year 2+ is an indicative
/// projection until a year-boundary recompute restates it from year-1
/// utilisation plus approved reallocations — so a forecast must never sum
/// committed and indicative money into one figure.
model GrantTranche {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  trancheNumber Int
  grantYear     Int
  plannedOn     DateTime      @db.Date
  plannedAmount Decimal       @db.Decimal(14, 2)
  status        TrancheStatus @default(planned)

  /// False until the year-boundary recompute confirms this year's figure.
  /// Nothing may be requested against an indicative tranche.
  isCommitted Boolean   @default(false)
  committedAt DateTime?
  /// What the figure was before the last restatement, so a changed projection
  /// can be explained rather than silently replaced.
  restatedFromAmount Decimal?  @db.Decimal(14, 2)
  restatedAt         DateTime?
  restatementNote    String?

  /// Extra release rule beyond conditions, e.g. "report for slot 2 approved".
  releaseRuleNote String?
  /// The report slot whose approval gates this tranche — the common real rule.
  gatingSlotId String?
  gatingSlot   BudgetReportSlot? @relation(fields: [gatingSlotId], references: [id], onDelete: SetNull)

  requests      DisbursementRequest[]
  disbursements Disbursement[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([budgetId, trancheNumber])
  @@index([budgetId, grantYear])
  @@index([status, plannedOn])
}

enum DisbursementRequestStatus {
  draft
  submitted
  approved
  rejected
  cancelled
}

/// A request to release a tranche. Maker-checker: whoever submits may not
/// approve, enforced in requireAuthority().
model DisbursementRequest {
  id        String       @id @default(cuid())
  trancheId String
  tranche   GrantTranche @relation(fields: [trancheId], references: [id], onDelete: Cascade)

  requestedAmount Decimal @db.Decimal(14, 2)
  /// The gate state at submit time, so a later condition discharge does not
  /// rewrite why this was allowed through.
  gateSnapshot    Json    @default("{}")
  justification   String

  status        DisbursementRequestStatus @default(draft)
  submittedById String?
  submittedBy   User?                     @relation("DisbursementRequester", fields: [submittedById], references: [id], onDelete: SetNull)
  submittedAt   DateTime?

  approvals     DisbursementApproval[]
  disbursements Disbursement[]
  rejectionNote String?
  resolvedAt    DateTime?
  createdAt     DateTime                  @default(now())

  @@index([trancheId])
  @@index([status, submittedAt])
}

/// One authority's sign-off on a request. Several rows where the DoA matrix
/// requires more than one.
model DisbursementApproval {
  id        String              @id @default(cuid())
  requestId String
  request   DisbursementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /// The DoA rule this satisfies. Plain id, no FK: the rule may be edited or
  /// retired later and this record must not change meaning.
  authorityRuleId String?
  /// Denormalised at approval time — what the matrix said when it mattered,
  /// including the policy clause it came from.
  authoritySnapshot Json @default("{}")

  approverId String
  approver   User     @relation("DisbursementApprover", fields: [approverId], references: [id], onDelete: Restrict)
  decision   String
  note       String?
  decidedAt  DateTime @default(now())

  @@unique([requestId, approverId])
}

/// Confirmation that an approved release was paid.
///
/// ACCOUNTING IS THE SYSTEM OF RECORD. This row mirrors a payment made in the
/// accounting system so the approved-vs-paid gap is visible here; Pitstops is
/// never the authority on a payment figure and nothing here touches a bank.
/// `bankReference` is what ties the two systems together, so a released row
/// without one is refused.
model Disbursement {
  id        String       @id @default(cuid())
  trancheId String
  tranche   GrantTranche @relation(fields: [trancheId], references: [id], onDelete: Restrict)
  budgetId  String
  budget    Budget       @relation(fields: [budgetId], references: [id], onDelete: Restrict)
  requestId String?
  request   DisbursementRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  amount Decimal @db.Decimal(14, 2)
  /// TDS or bank charges withheld at source.
  tdsAmount Decimal @db.Decimal(14, 2) @default(0)
  /// amount − tdsAmount. Stored, because this is what the bank actually moved
  /// and what the grantee reconciles against.
  netAmount Decimal @db.Decimal(14, 2)

  valueDate DateTime @db.Date
  /// UTR / NEFT / cheque number. The reconciliation key against accounting.
  bankReference    String?
  instrument       String?
  fromAccountLabel String?

  status      DisbursementStatus @default(pending)
  failureNote String?

  /// Reconciliation against what the grantee reports having received.
  reconciledReportId String?
  reconciledReport   BudgetReport? @relation("DisbursementReconciliation", fields: [reconciledReportId], references: [id], onDelete: SetNull)
  reconciledAt       DateTime?
  /// Signed rupees: reported − released. Non-zero is a finding, not an error.
  reconciliationDelta Decimal? @db.Decimal(14, 2)

  recordedById String?
  recordedBy   User?    @relation("DisbursementRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  documents GrantDocument[]

  @@index([budgetId, valueDate])
  @@index([status, valueDate])
  @@index([bankReference])
}

// ── 1.4 Closure ──────────────────────────────────────────────────────────────

enum GrantClosureStatus {
  open
  closing
  closed
  closed_with_exception
}

enum GrantExitDecision {
  undecided
  renew
  exit
  pause
}

/// The terminal state. Nothing ended before this: lapse.ts reported unspent
/// money as a sizing signal and no grant ever reached a final state.
model GrantClosure {
  id       String @id @default(cuid())
  budgetId String @unique
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  status      GrantClosureStatus @default(open)
  initiatedAt DateTime?
  closedAt    DateTime?

  /// Frozen at closure, not read live afterwards: a closed grant's numbers must
  /// not drift when the registry or the reports move underneath them.
  totalReleased Decimal @db.Decimal(14, 2) @default(0)
  totalUtilised Decimal @db.Decimal(14, 2) @default(0)
  /// released − utilised − carriedForward, floored at 0.
  unspentAmount Decimal @db.Decimal(14, 2) @default(0)

  /// How the unspent balance was settled. Decided case by case, so there is NO
  /// DEFAULT and nothing is inferred: where unspentAmount > 0 a person must set
  /// this before closure can be signed off. A default here would quietly assert
  /// a financial position nobody took.
  settlementMode String?
  /// Required when settlementMode = adjusted_against_renewal: the budget the
  /// balance was carried into. Without it a carry-forward is untraceable and
  /// the money appears twice across two grants.
  adjustedIntoBudgetId String?
  adjustedIntoBudget   Budget? @relation("ClosureAdjustment", fields: [adjustedIntoBudgetId], references: [id], onDelete: SetNull)
  refundReceivedOn     DateTime? @db.Date
  refundAmount         Decimal?  @db.Decimal(14, 2)
  refundReference      String?
  writeOffNote         String?

  /// Outstanding borrowings must be settled or explicitly carried.
  borrowingsSettled Boolean @default(false)

  exitDecision GrantExitDecision @default(undecided)
  exitNote     String?

  /// Mandatory when status = closed_with_exception. Never a silent pass.
  exceptionNote String?

  closedById String?
  closedBy   User?    @relation("GrantCloser", fields: [closedById], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assets       GrantAsset[]
  documents    GrantDocument[]
  reminderLogs GrantClosureReminderLog[]

  @@index([status, closedAt])
}

/// Assets bought with grant money, and where they ended up. Asked for at
/// closure and nowhere recorded until now.
model GrantAsset {
  id        String       @id @default(cuid())
  closureId String
  closure   GrantClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)

  description String
  quantity    Int      @default(1)
  cost        Decimal  @db.Decimal(14, 2)
  acquiredOn  DateTime? @db.Date
  /// retained_by_grantee | returned | transferred | written_off
  disposition String
  dispositionNote String?

  @@index([closureId])
}

/// One row per (closure, threshold) the closure-due cron has already fired, so
/// a re-run on the same day is a no-op. Mirrors BudgetReportReminderLog.
model GrantClosureReminderLog {
  id        String       @id @default(cuid())
  closureId String
  closure   GrantClosure @relation(fields: [closureId], references: [id], onDelete: Cascade)
  threshold String
  sentAt    DateTime     @default(now())

  @@unique([closureId, threshold])
}

// ── 2.2 Delegation of authority ──────────────────────────────────────────────

/// What a given role or person may approve, up to what amount, for which
/// action. Data, not code: a live admin UI, not a constant.
///
/// NO MATCHING RULE MEANS REFUSAL, so a default ruleset must be seeded with the
/// migration or every amount-bearing route stops. The ruleset is a
/// transcription of the written finance policy; `policyReference` carries the
/// clause so a refusal can be traced back to the paper that caused it.
model AuthorityRule {
  id String @id @default(cuid())

  /// Closed vocabulary in lib/budget/authority.ts: grant_decision |
  /// budget_finalise | report_approve | reallocation_approve |
  /// disbursement_approve | condition_waive | closure_close | gate_override
  action String

  /// Scope. Null on either = any.
  grantingUnitId String?
  grantingUnit   GrantingUnit? @relation(fields: [grantingUnitId], references: [id], onDelete: Cascade)
  domain         String?

  /// Who holds it: an app role, a named person, or a POSITION ON THE GRANT
  /// ITSELF. Exactly one.
  ///
  /// `grantRole` is what makes a genuine two-person rule expressible: "the
  /// grant's programme_finance must approve" binds to whoever holds that role
  /// on the grant in question, so the matrix never has to name individuals and
  /// does not go stale when someone moves on.
  roleId String?
  role   Role?   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  userId String?
  user   User?   @relation("AuthorityHolder", fields: [userId], references: [id], onDelete: Cascade)
  grantRole GrantRole?

  /// Inclusive rupee ceiling. Null = unlimited.
  maxAmount Decimal? @db.Decimal(14, 2)
  /// How many distinct holders must approve. 2 = maker-checker at this level.
  approvalsRequired Int @default(1)
  /// When true, the submitter may not be one of the approvers.
  excludeSubmitter Boolean @default(true)

  /// Lower number wins when several rules match.
  priority Int      @default(100)
  isActive Boolean  @default(true)
  note     String?
  /// The clause of the written DoA policy this rule encodes, e.g.
  /// "Finance Policy v4 §6.2(b)".
  policyReference String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([action, isActive, priority])
}

/// Temporary transfer of someone's authority while they are away.
model AuthorityDelegation {
  id         String @id @default(cuid())
  fromUserId String
  fromUser   User   @relation("DelegationFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId   String
  toUser     User   @relation("DelegationTo", fields: [toUserId], references: [id], onDelete: Cascade)

  /// Null = all actions the delegator holds.
  action String?
  /// A delegate may be capped below the delegator's own ceiling.
  maxAmount Decimal? @db.Decimal(14, 2)

  startsOn DateTime @db.Date
  endsOn   DateTime @db.Date
  reason   String?
  isActive Boolean  @default(true)

  createdById String?
  createdBy   User?    @relation("DelegationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([toUserId, isActive, startsOn, endsOn])
  @@index([fromUserId, isActive])
}

// ── 2.3 Compliance calendar ──────────────────────────────────────────────────

/// A statutory registration with a VALIDITY WINDOW, which is what the existing
/// due-diligence JSON lacks: it holds point-in-time answers, so an expiring
/// 12A or FCRA certificate is invisible until someone re-reads the file.
model OrgCompliance {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// Matches ComplianceKindConfig.kind: reg_12a | reg_80g | fcra | csr1 |
  /// pan | tan | gst | audited_accounts | form_10bd | darpan | trust_deed
  kind       String
  identifier String?
  issuedOn   DateTime? @db.Date
  /// Null = no expiry (a PAN never expires; an FCRA certificate does).
  validUntil DateTime? @db.Date

  documentId String?
  verifiedById String?
  verifiedBy   User?     @relation("ComplianceVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt   DateTime?
  note         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, kind])
  @@index([validUntil])
  @@index([kind, validUntil])
}

/// Which registrations matter, how long before expiry to warn, and whether an
/// expired one blocks a release. Data so a new statutory requirement does not
/// need a deploy.
model ComplianceKindConfig {
  id    String @id @default(cuid())
  kind  String @unique
  label String

  /// Does an expired or missing row block a disbursement? This is what feeds
  /// releaseGate() — the difference between a warning and a gate.
  blocksRelease Boolean @default(false)
  isRequired    Boolean @default(true)
  /// Days before validUntil to start warning.
  warnDays Int     @default(60)
  isActive Boolean @default(true)
  note     String?
}

// ── 2.4 Conflict of interest ─────────────────────────────────────────────────

enum ConflictDisposition {
  disclose
  recuse
}

/// A declared interest in a grantee org. Checked inside requireAuthority: a
/// live `recuse` declaration refuses the action outright, while `disclose`
/// passes and stamps the declaration id into the decision's authority snapshot.
model ConflictDeclaration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ConflictDeclarant", fields: [userId], references: [id], onDelete: Cascade)
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  nature      String
  disposition ConflictDisposition @default(disclose)

  declaredOn DateTime  @db.Date
  /// Null = still live.
  endedOn    DateTime? @db.Date

  reviewedById String?
  reviewedBy   User?     @relation("ConflictReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?
  reviewNote   String?

  createdAt DateTime @default(now())

  @@index([userId, endedOn])
  @@index([orgId, endedOn])
}

// ── Phase 3: intake and pipeline ─────────────────────────────────────────────

enum FundingWindowStatus {
  draft
  open
  closed
  archived
}

/// A call for proposals. Intake is a PUBLIC open call, so this carries the
/// published dates and the public slug the unauthenticated form is served from.
model FundingWindow {
  id   String @id @default(cuid())
  name String
  slug String @unique

  grantingUnitId String?
  grantingUnit   GrantingUnit? @relation(fields: [grantingUnitId], references: [id], onDelete: SetNull)

  status    FundingWindowStatus @default(draft)
  opensOn   DateTime?           @db.Date
  closesOn  DateTime?           @db.Date
  /// Published guidance, eligibility and the question set, as data.
  brief     String?
  questions Json                @default("[]")
  /// Indicative ceiling shown to applicants.
  ceilingAmount Decimal? @db.Decimal(14, 2)

  proposals Proposal[]
  rubrics   ProposalRubric[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([status, closesOn])
}

enum ProposalStage {
  received
  screening
  eligible
  ineligible
  due_diligence
  appraisal
  decided
  withdrawn
}

/// An inbound proposal. Built on the screening module's bones — idempotent
/// intake on a public ref, structured answers, documents, a versioned rubric
/// whose edits never change a recorded total, and an event trail — but kept as
/// its own model: a grantee org and a fellowship applicant have genuinely
/// different fields, and one polymorphic table would be worse.
model Proposal {
  id       String        @id @default(cuid())
  windowId String?
  window   FundingWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)

  /// Idempotency key for the public form: a resubmitted draft must not create
  /// a second proposal.
  publicRef String @unique

  /// Applicant identity. `orgId` is set once the org is matched or created, so
  /// the free-text name is what the applicant typed, never the registry's.
  orgId           String?
  org             Org?    @relation(fields: [orgId], references: [id], onDelete: SetNull)
  applicantOrgName String
  contactName     String
  contactEmail    String
  contactPhone    String?

  title           String
  summary         String?
  requestedAmount Decimal? @db.Decimal(14, 2)
  requestedMonths Int?
  domains         String[] @default([])
  city            String?

  answers   Json @default("{}")
  /// Whether the applicant is asking for a first grant or a continuation.
  /// Carried onto the Budget at linkProposalToBudget().
  continuity GrantContinuity?
  stage     ProposalStage @default(received)
  /// Required on ineligible / withdrawn, so a decline is never unexplained.
  declineReasonCode String?
  declineReasonNote String?

  /// Magic-link resume for the public form. Hashed, never the raw token.
  resumeTokenHash String?
  resumeExpiresAt DateTime?
  submittedAt     DateTime?

  /// Set when the proposal becomes a budget — the join from intake to grant.
  budgetId String? @unique
  budget   Budget? @relation(fields: [budgetId], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("ProposalAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)

  reviews   ProposalReview[]
  events    ProposalEvent[]
  documents GrantDocument[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage, createdAt])
  @@index([windowId, stage])
  @@index([orgId])
}

/// A versioned scoring sheet. The rubric is COPIED onto each review, so editing
/// the rubric never changes a score already recorded.
model ProposalRubric {
  id       String        @id @default(cuid())
  windowId String?
  window   FundingWindow? @relation(fields: [windowId], references: [id], onDelete: SetNull)

  name     String
  version  Int     @default(1)
  /// [{ key, label, weight, maxScore, guidance }]
  criteria Json    @default("[]")
  isActive Boolean @default(true)

  reviews   ProposalReview[]
  createdAt DateTime @default(now())

  @@index([windowId, isActive])
}

model ProposalReview {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  reviewerId String
  reviewer   User   @relation("ProposalReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  /// 1 = first pass, 2 = second. Divergence between two level-2 totals routes
  /// to the granting-unit lead.
  level Int @default(1)

  rubricId String?
  rubric   ProposalRubric? @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  /// The rubric as it stood when this review was scored.
  rubricSnapshot Json @default("{}")
  scores         Json @default("{}")
  totalScore     Float?

  recommendation String?
  note           String?
  submittedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@unique([proposalId, reviewerId, level])
  @@index([proposalId])
}

/// The proposal audit trail, in the module's own shape. Distinct from
/// AuditLog: these are pipeline events the applicant-facing timeline reads
/// back, not sensitive-action records.
model ProposalEvent {
  id         String   @id @default(cuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  kind    String
  detail  Json     @default("{}")
  actorId String?
  actor   User?    @relation("ProposalEventActor", fields: [actorId], references: [id], onDelete: SetNull)
  /// True for events the applicant may see on the public status page.
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([proposalId, createdAt])
}

// ── Phase 4: results ─────────────────────────────────────────────────────────

/// An indicator a grant promised, with its target. The framework half of
/// reporting, which until now was financial-only.
model GrantResult {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  /// output | outcome
  level     String  @default("output")
  indicator String
  unit      String?
  /// Null where the indicator is narrative-only.
  targetValue Float?
  /// Which domain of the grant this belongs to; null = whole grant.
  domain      String?
  /// derived indicators are computed from delivery data rather than typed.
  derivedFrom String?
  position    Int     @default(0)

  values    GrantResultValue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([budgetId])
}

/// One period's actual against a target. Both the grantee's figure and a
/// reviewer's dispute are kept — neither overwrites the other.
model GrantResultValue {
  id       String      @id @default(cuid())
  resultId String
  result   GrantResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  slotId   String
  slot     BudgetReportSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)

  value  Float?
  /// derived | grantee | staff
  source String  @default("grantee")
  note   String?
  reviewerValue Float?
  reviewerNote  String?
  updatedAt     DateTime @updatedAt

  @@unique([resultId, slotId])
}

/// The narrative half of a report. Sections as data so the template can change
/// per granting unit without a deploy.
model BudgetReportNarrative {
  id       String       @id @default(cuid())
  reportId String       @unique
  report   BudgetReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  /// [{ key, heading, body }] against a template on GrantingUnit.
  sections Json    @default("[]")
  /// Grantee-reported challenges and changes — the part funders actually read.
  deviationsNote String?
  submittedAt    DateTime?
  updatedAt      DateTime  @updatedAt
}

// ═══════════════════════════════════════════════════════════════════════════════
// GRANT LIFECYCLE — second pass
//
// Four additions, each closing a gap found by reading what the organisation
// already captures in the system this replaces (docs/fluxx-read-across.md).
// They are domain facts, not an imported design: the legacy system's own
// object model, state machine and terminology were deliberately left behind.
// ═══════════════════════════════════════════════════════════════════════════════

/// Who holds which responsibility on a grant.
///
/// `Budget.grantLeadId` names one person. In practice a grant has five, and the
/// split matters: programme judgement and financial judgement sit with
/// different people, which is what makes maker-checker more than a formality.
/// An authority rule can therefore require "the grant's programme_finance"
/// without naming an individual in the matrix (AuthorityRule.grantRole).
enum GrantRole {
  programme_lead
  programme_finance
  effects_and_learning
  location_team
  consultant
  /// Kept open: the set has grown before and will again.
  other
}

/// A join rather than five columns on Budget: people change mid-grant, the set
/// grows, and only a join keeps the history of who held what when.
model GrantRoleAssignment {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  role   GrantRole
  userId String
  user   User      @relation("GrantRoleHolder", fields: [userId], references: [id], onDelete: Cascade)

  /// Null = still holding it. A past holder is kept, not deleted: an approval
  /// they gave must remain explicable afterwards.
  startedOn DateTime  @db.Date
  endedOn   DateTime? @db.Date
  note      String?

  assignedById String?
  assignedBy   User?    @relation("GrantRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  /// One live holder per role per grant is enforced in code, not here — a
  /// partial unique index cannot be expressed in Prisma, and a handover needs
  /// both rows to exist for the instant between them.
  @@index([budgetId, role, endedOn])
  @@index([userId, endedOn])
}

enum Rag {
  red
  amber
  green
}

/// A reviewer's judgement of a grant's health for one reporting period.
///
/// Reports say what was spent and what was delivered. Nothing said what anyone
/// CONCLUDED — and a grant can be entirely compliant on paper and still be in
/// trouble. Two axes rather than one, because the programme view and the
/// finance view diverge often enough that averaging them hides the problem.
model GrantAssessment {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  /// The reporting period assessed. Null for an off-cycle assessment, e.g.
  /// after a site visit that raised something.
  slotId   String?
  slot     BudgetReportSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  programmeRag       Rag
  /// Required unless the rating is green — a colour with no reason is the
  /// field people learn to scroll past.
  programmeRationale String?
  financeRag         Rag
  financeRationale   String?
  /// Not derived from the two above: a reviewer may weigh them, and recording
  /// the weighing is the point.
  overallRag         Rag
  overallNote        String?

  assessedOn   DateTime @db.Date
  assessedById String?
  assessedBy   User?    @relation("GrantAssessor", fields: [assessedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([budgetId, slotId])
  @@index([budgetId, assessedOn])
  @@index([overallRag, assessedOn])
}

/// How this grant stands in relation to what came before it for the same
/// partner. Renewal is the normal shape of grant-making in a long-term
/// portfolio; modelling every grant as a first grant loses the history that
/// makes an appraisal quick.
enum GrantContinuity {
  new
  continuing
  scale_up
  deepening
}

/// One financial year of a grantee's own accounts.
///
/// Needed for the dependency ratio — this grant as a share of what the
/// organisation spends in a year — which is a real appraisal measure and
/// cannot be computed from anything we held. Also feeds the "average annual
/// expenditure" and dependency lines the approvals wizard already renders.
model OrgFinancialYear {
  id    String @id @default(cuid())
  orgId String
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The year ENDING in this calendar year, e.g. 2026 for FY ending March 2026.
  /// Indian FYs end in March, so a single year label is unambiguous here in a
  /// way a start year would not be.
  yearEnding  Int
  expenditure Decimal  @db.Decimal(14, 2)
  income      Decimal? @db.Decimal(14, 2)
  /// Whether these figures come from audited accounts or from a declaration.
  /// A ratio computed from unaudited figures is worth less and should say so.
  isAudited   Boolean  @default(false)
  source      String?

  recordedById String?
  recordedBy   User?    @relation("OrgFinancialRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([orgId, yearEnding])
  @@index([orgId, yearEnding])
}
